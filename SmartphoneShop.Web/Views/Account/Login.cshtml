@{
    ViewData["Title"] = "Вход";
}

<section>
    <div class="container">
        <h2 class="section-title">Вход в аккаунт</h2>
        
        @if (TempData["Error"] != null)
        {
            <div class="service-card" style="margin-bottom: 30px; max-width: 500px; margin-left: auto; margin-right: auto;">
                <p>@TempData["Error"]</p>
            </div>
        }

        <div style="max-width: 500px; margin: 0 auto;">
            <div class="service-card">
                <form method="post" action="/account/login">
                    @if (ViewBag.ReturnUrl != null)
                    {
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    }
                    
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="email" required placeholder="your@email.com" />
                    </div>
                    
                    <div class="form-group">
                        <label>Пароль</label>
                        <input type="password" name="password" required placeholder="Ваш пароль" />
                    </div>
                    
                    <button type="submit" class="cta-button" style="width: 100%; margin-top: 20px;">Войти</button>
                </form>
                
                <p style="text-align: center; margin-top: 20px; color: #b0b0b0;">
                    Нет аккаунта? <a href="/account/register" style="color: #D44177;">Зарегистрируйтесь</a>
                </p>
            </div>
        </div>
    </div>
</section>