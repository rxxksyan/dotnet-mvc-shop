@using Microsoft.AspNetCore.Identity
@using SmartphoneShop.Core.Entities
@model AppUser
@inject UserManager<AppUser> UserManager
@{
    ViewData["Title"] = "Личный кабинет";
    var userRoles = await UserManager.GetRolesAsync(Model);
    
    var roleTranslations = new Dictionary<string, string>
    {
        { "Admin", "Администратор" },
        { "Expert", "Эксперт" },
        { "ProductAdmin", "Админ товаров" },
        { "RepairSpecialist", "Специалист ремонта" },
        { "User", "Пользователь" }
    };
    
    string GetRoleName(string role) => roleTranslations.ContainsKey(role) ? roleTranslations[role] : role;
}

<style>
    .status-neutral { background: rgba(212, 65, 119, 0.15); color: #D44177; }
    .status-active { background: rgba(212, 65, 119, 0.25); color: #D44177; border: 1px solid rgba(212, 65, 119, 0.4); }
    .status-done { background: rgba(255, 255, 255, 0.1); color: #f0f0f0; }
    .status-stopped { background: rgba(100, 100, 100, 0.2); color: #888; }
</style>

<section>
    <div class="container">
        <h2 class="section-title">Личный кабинет</h2>

        <div style="display: grid; grid-template-columns: 350px 1fr; gap: 30px;">
            
            <div class="service-card" style="text-align: center; padding: 30px;">
                <div style="width: 100px; height: 100px; border-radius: 50%; background: #D44177; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <span style="color: white; font-size: 40px; font-weight: bold;">@(Model.FullName?.Split(' ').FirstOrDefault()?.Substring(0, 1) ?? "U")</span>
                </div>
                
                <h3>@Model.FullName</h3>
                <p style="color: #b0b0b0; margin-bottom: 10px;">@Model.Email</p>
                <div style="display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 25px;">
                    @foreach (var role in userRoles)
                    {
                        <span style="background: rgba(212, 65, 119, 0.15); color: #D44177; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 500;">@GetRoleName(role)</span>
                    }
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 25px;">
                    <button class="cta-button" style="width: 100%;" onclick="openModal('editProfileModal')">Редактировать профиль</button>
                    <button class="cta-button" style="width: 100%; background: #3a3a3a;" onclick="openModal('changePasswordModal')">Изменить пароль</button>
                </div>

                <hr style="border-color: #3a3a3a; margin: 25px 0;">

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px;">
                    <div>
                        <div style="font-size: 24px; font-weight: bold; color: #D44177;">@Model.Orders.Count</div>
                        <div style="color: #b0b0b0; font-size: 14px;">Заказов</div>
                    </div>
                    <div>
                        <div style="font-size: 24px; font-weight: bold; color: #D44177;">@Model.Reviews.Count</div>
                        <div style="color: #b0b0b0; font-size: 14px;">Отзывов</div>
                    </div>
                    <div>
                        <div style="font-size: 24px; font-weight: bold; color: #D44177;">@Model.RepairRequests.Count</div>
                        <div style="color: #b0b0b0; font-size: 14px;">Ремонтов</div>
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 30px;">
                <div class="service-card">
                    <h3>Данные аккаунта</h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div style="padding: 15px; background: #1a1a1a; border-radius: 8px;">
                            <label style="color: #b0b0b0; font-size: 13px; text-transform: uppercase; margin-bottom: 8px; display: block;">ФИО</label>
                            <p style="font-size: 18px; margin: 0;">@Model.FullName</p>
                        </div>
                        <div style="padding: 15px; background: #1a1a1a; border-radius: 8px;">
                            <label style="color: #b0b0b0; font-size: 13px; text-transform: uppercase; margin-bottom: 8px; display: block;">Email</label>
                            <p style="font-size: 18px; margin: 0;">@Model.Email</p>
                        </div>
                        <div style="padding: 15px; background: #1a1a1a; border-radius: 8px;">
                            <label style="color: #b0b0b0; font-size: 13px; text-transform: uppercase; margin-bottom: 8px; display: block;">Телефон</label>
                            <p style="font-size: 18px; margin: 0;">@(string.IsNullOrEmpty(Model.Phone) ? "<span style=\"color: #b0b0b0;\">Не указан</span>" : Model.Phone)</p>
                        </div>
                        <div style="padding: 15px; background: #1a1a1a; border-radius: 8px;">
                            <label style="color: #b0b0b0; font-size: 13px; text-transform: uppercase; margin-bottom: 8px; display: block;">Дата регистрации</label>
                            <p style="font-size: 18px; margin: 0;">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>

                <div class="service-card">
                    <h3>История заказов</h3>
                    @functions {
                        string StatusRus(SmartphoneShop.Core.Enums.OrderStatus s) => s switch {
                            SmartphoneShop.Core.Enums.OrderStatus.Pending => "Оформлен",
                            SmartphoneShop.Core.Enums.OrderStatus.Confirmed => "Подтверждён",
                            SmartphoneShop.Core.Enums.OrderStatus.Shipped => "Отправлен",
                            SmartphoneShop.Core.Enums.OrderStatus.Delivered => "Доставлен",
                            SmartphoneShop.Core.Enums.OrderStatus.Cancelled => "Отменён",
                            _ => "Оформлен"
                        };
                    }
                    @if (Model.Orders.Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 15px;">
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                            {
                                <div class="card" style="padding: 20px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <h4 style="margin: 0 0 8px 0;">Заказ #@order.Id</h4>
                                            <p style="margin: 0; color: #b0b0b0; font-size: 14px;">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                        </div>
                                        <div style="text-align: right;">
                                            <span class="badge @(order.Status == SmartphoneShop.Core.Enums.OrderStatus.Delivered ? "status-delivered" : order.Status == SmartphoneShop.Core.Enums.OrderStatus.Cancelled ? "status-cancelled" : "status-pending")" style="margin-bottom: 8px; border-radius: 20px; padding: 6px 14px;">@StatusRus(order.Status)</span>
                                            <p style="margin: 8px 0 0 0; font-size: 20px; font-weight: bold; color: #D44177;">@order.TotalAmount.ToString("N0") BYN</p>
                                        </div>
                                    </div>
                                    <button type="button" style="background: none; border: none; color: #b0b0b0; cursor: pointer; padding: 8px 0; margin-top: 10px; width: 100%; text-align: left;" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'; this.textContent = this.textContent.includes('Подробнее') ? 'Скрыть детали' : 'Подробнее о заказе';">
                                        <span class="order-toggle">▼ Подробнее о заказе</span>
                                    </button>
                                    <div style="display: none; padding-top: 15px; margin-top: 15px; border-top: 1px solid #3a3a3a;">
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px;">
                                            <div>
                                                <span style="color: #b0b0b0; font-size: 13px;">Адрес:</span>
                                                <p style="margin: 2px 0 0 0;">@order.DeliveryAddress</p>
                                            </div>
                                            <div>
                                                <span style="color: #b0b0b0; font-size: 13px;">Получатель:</span>
                                                <p style="margin: 2px 0 0 0;">@order.ContactName</p>
                                            </div>
                                        </div>
                                        <div>
                                            <span style="color: #b0b0b0; font-size: 13px;">Товары:</span>
                                            @foreach (var item in order.Items)
                                            {
                                                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #3a3a3a;">
                                                    <span>@item.Smartphone.ModelName × @item.Quantity</span>
                                                    <span style="color: #D44177;">@item.TotalPrice.ToString("N0") BYN</span>
                                                </div>
                                            }
                                        </div>
                                        <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                                            <strong>Итого:</strong>
                                            <strong style="color: #D44177; font-size: 18px;">@order.TotalAmount.ToString("N0") BYN</strong>
                                        </div>
                                        <div style="display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap;">
                                            @if (order.Status == SmartphoneShop.Core.Enums.OrderStatus.Cancelled)
                                            {
                                                <p style="color: #e74c3c; font-size: 13px;">Заказ отменён. Документы недоступны.</p>
                                            }
                                            else
                                            {
                                                <button type="button" class="cta-button" style="font-size: 13px; padding: 8px 16px;" data-original-text="Скачать чек" onclick="downloadDocument('receipt-p-@order.Id', 'receipt-order-@(order.Id).pdf')">Скачать чек</button>
                                                <button type="button" class="cta-button" style="font-size: 13px; padding: 8px 16px; background: #3a3a3a;" data-original-text="Гарантийный талон" onclick="downloadDocument('warranty-p-@order.Id', 'warranty-order-@(order.Id).pdf')">Гарантийный талон</button>
                                            }
                                        </div>
                                    </div>

                                    @if (order.Status != SmartphoneShop.Core.Enums.OrderStatus.Cancelled)
                                    {
                                    <div id="receipt-p-@order.Id" style="display:none; width:800px; background:#1a1a1a; padding:40px 48px; color:#e0e0e0; font-family: Arial, sans-serif;">
                                        <div style="text-align:center; margin-bottom:32px; padding-bottom:20px; border-bottom:2px solid #D44177;">
                                            <div style="color:#D44177; font-weight:900; font-size:30px; letter-spacing:5px;">RXXMRKT</div>
                                            <div style="color:#999; font-size:11px; margin-top:6px; letter-spacing:2px;">ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ</div>
                                            <div style="color:#888; font-size:11px; margin-top:2px;">УНП 193654321, р/с BY65ALFA30123456780000000</div>
                                            <div style="color:#888; font-size:11px;">г. Минск, ул. Сурганова, 57Б</div>
                                        </div>
                                        <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:28px;">
                                            <div>
                                                <div style="color:#666; font-size:10px; letter-spacing:1px;">ДОКУМЕНТ</div>
                                                <div style="font-size:22px; font-weight:800; color:#fff; margin-top:4px;">ТОВАРНЫЙ ЧЕК №@order.Id</div>
                                            </div>
                                            <div style="text-align:right;">
                                                <div style="color:#999; font-size:13px;">@order.CreatedAt.ToString("dd.MM.yyyy")</div>
                                                <div style="color:#999; font-size:13px;">@order.CreatedAt.ToString("HH:mm")</div>
                                            </div>
                                        </div>
                                        <div style="display:flex; gap:24px; margin-bottom:28px;">
                                            <div style="flex:1; background:#242424; border-radius:8px; padding:16px 20px;">
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:8px;">ПЛАТЕЛЬЩИК</div>
                                                <div style="color:#e0e0e0; font-weight:600;">@order.ContactName</div>
                                                <div style="color:#999; font-size:13px; margin-top:2px;">тел. @order.ContactPhone</div>
                                            </div>
                                            <div style="flex:1; background:#242424; border-radius:8px; padding:16px 20px;">
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:8px;">СПОСОБ ПОЛУЧЕНИЯ</div>
                                                <div style="color:#e0e0e0; font-weight:600;">@(order.DeliveryType == SmartphoneShop.Core.Enums.DeliveryType.Pickup ? "Самовывоз" : "Доставка")</div>
                                                <div style="color:#999; font-size:13px; margin-top:2px;">@order.DeliveryAddress</div>
                                            </div>
                                            <div style="flex:1; background:#242424; border-radius:8px; padding:16px 20px;">
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:8px;">СТАТУС</div>
                                                <div style="color:#D44177; font-weight:700; font-size:13px;">@(order.Status == SmartphoneShop.Core.Enums.OrderStatus.Delivered ? "ДОСТАВЛЕН" : order.Status == SmartphoneShop.Core.Enums.OrderStatus.Confirmed ? "ПОДТВЕРЖДЁН" : order.Status == SmartphoneShop.Core.Enums.OrderStatus.Shipped ? "ОТПРАВЛЕН" : order.Status == SmartphoneShop.Core.Enums.OrderStatus.Cancelled ? "ОТМЕНЁН" : "ОФОРМЛЕН")</div>
                                            </div>
                                        </div>
                                        <div style="margin-bottom:24px;">
                                            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                                <thead>
                                                    <tr style="background:#242424; border-bottom:2px solid #D44177;">
                                                        <th style="padding:12px 14px; text-align:left; color:#D44177; font-size:10px; letter-spacing:1px;">НАИМЕНОВАНИЕ</th>
                                                        <th style="padding:12px 14px; text-align:center; color:#D44177; font-size:10px; letter-spacing:1px; width:70px;">КОЛ-ВО</th>
                                                        <th style="padding:12px 14px; text-align:right; color:#D44177; font-size:10px; letter-spacing:1px; width:100px;">ЦЕНА</th>
                                                        <th style="padding:12px 14px; text-align:right; color:#D44177; font-size:10px; letter-spacing:1px; width:120px;">СУММА</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in order.Items)
                                                    {
                                                        <tr style="border-bottom:1px solid #2a2a2a;">
                                                            <td style="padding:10px 14px; color:#e0e0e0; font-weight:600;">@item.Smartphone.ModelName</td>
                                                            <td style="padding:10px 14px; text-align:center; color:#b0b0b0;">@item.Quantity</td>
                                                            <td style="padding:10px 14px; text-align:right; color:#b0b0b0;">@item.PriceAtPurchase.ToString("N0")</td>
                                                            <td style="padding:10px 14px; text-align:right; color:#fff; font-weight:700;">@item.TotalPrice.ToString("N0") BYN</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div style="background:#242424; border-radius:8px; padding:24px; margin-bottom:28px;">
                                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                                <div>
                                                    <div style="color:#888; font-size:11px; letter-spacing:1px; margin-bottom:2px;">ИТОГО К ОПЛАТЕ</div>
                                                    <div style="color:#999; font-size:12px;">@order.Items.Count() @(order.Items.Count() == 1 ? "позиция" : "позиции(ий)")</div>
                                                </div>
                                                <div style="text-align:right;">
                                                    <div style="font-size:32px; font-weight:900; color:#D44177;">@order.TotalAmount.ToString("N0")</div>
                                                    <div style="color:#D44177; font-size:14px; font-weight:600; margin-top:2px;">BYN</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div style="text-align:center; padding-top:24px; border-top:1px solid #2a2a2a;">
                                            <div style="color:#D44177; font-size:24px; font-weight:900; letter-spacing:3px; margin-bottom:4px;">RXXMRKT</div>
                                            <div style="color:#555; font-size:11px;">Спасибо за покупку!</div>
                                            <div style="color:#555; font-size:10px; margin-top:2px;">Возврат и обмен в течение 14 дней при наличии чека</div>
                                        </div>
                                    </div>

                                    <div id="warranty-p-@order.Id" style="display:none; width:800px; background:#1a1a1a; padding:40px 48px; color:#e0e0e0; font-family: Arial, sans-serif;">
                                        <div style="text-align:center; margin-bottom:32px; padding-bottom:20px; border-bottom:2px solid #D44177;">
                                            <div style="color:#D44177; font-weight:900; font-size:30px; letter-spacing:5px;">RXXMRKT</div>
                                            <div style="color:#999; font-size:11px; margin-top:6px; letter-spacing:2px;">ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ</div>
                                            <div style="color:#888; font-size:11px; margin-top:2px;">УНП 193654321, р/с BY65ALFA30123456780000000</div>
                                            <div style="color:#888; font-size:11px;">г. Минск, ул. Сурганова, 57Б</div>
                                        </div>
                                        <div style="text-align:center; margin-bottom:36px;">
                                            <div style="font-size:28px; font-weight:900; color:#fff; letter-spacing:3px;">ГАРАНТИЙНЫЙ ТАЛОН</div>
                                            <div style="color:#999; font-size:13px; margin-top:8px;">№ @order.Id от @order.CreatedAt.ToString("dd.MM.yyyy")</div>
                                        </div>
                                        <div style="background:#242424; border-radius:8px; padding:24px; margin-bottom:24px;">
                                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                                                <div>
                                                    <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:6px;">ПОКУПАТЕЛЬ</div>
                                                    <div style="color:#e0e0e0; font-weight:600; font-size:15px;">@order.ContactName</div>
                                                    <div style="color:#999; font-size:13px; margin-top:4px;">тел. @order.ContactPhone</div>
                                                </div>
                                                <div>
                                                    <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:6px;">ДАТА ПОКУПКИ</div>
                                                    <div style="color:#e0e0e0; font-weight:600; font-size:15px;">@order.CreatedAt.ToString("dd.MM.yyyy")</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div style="margin-bottom:24px;">
                                            <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:12px;">ПРИОБРЕТЁННЫЕ ТОВАРЫ</div>
                                            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                                <thead>
                                                    <tr style="background:#242424; border-bottom:2px solid #D44177;">
                                                        <th style="padding:12px 14px; text-align:left; color:#D44177; font-size:10px; letter-spacing:1px;">НАИМЕНОВАНИЕ</th>
                                                        <th style="padding:12px 14px; text-align:center; color:#D44177; font-size:10px; letter-spacing:1px; width:70px;">КОЛ-ВО</th>
                                                        <th style="padding:12px 14px; text-align:right; color:#D44177; font-size:10px; letter-spacing:1px; width:120px;">ЦЕНА</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in order.Items)
                                                    {
                                                        <tr style="border-bottom:1px solid #2a2a2a;">
                                                            <td style="padding:10px 14px; color:#e0e0e0; font-weight:600;">@item.Smartphone.ModelName</td>
                                                            <td style="padding:10px 14px; text-align:center; color:#b0b0b0;">@item.Quantity</td>
                                                            <td style="padding:10px 14px; text-align:right; color:#fff; font-weight:700;">@item.PriceAtPurchase.ToString("N0") BYN</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:36px;">
                                            <div>
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:8px;">СРОК ГАРАНТИИ</div>
                                                <div style="color:#D44177; font-weight:700; font-size:18px;">12 месяцев</div>
                                                <div style="color:#999; font-size:12px; margin-top:4px;">с @order.CreatedAt.ToString("dd.MM.yyyy") по @order.CreatedAt.AddMonths(12).ToString("dd.MM.yyyy")</div>
                                            </div>
                                            <div>
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:8px;">СУММА ПОКУПКИ</div>
                                                <div style="color:#D44177; font-weight:700; font-size:18px;">@order.TotalAmount.ToString("N0") BYN</div>
                                            </div>
                                        </div>
                                        <div style="display:flex; justify-content:space-between; margin-top:48px; padding-top:24px; border-top:1px solid #2a2a2a;">
                                            <div>
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:30px;">ПРОДАВЕЦ</div>
                                                <div style="border-top:1px solid #555; padding-top:8px; color:#999; font-size:12px;">М.П.</div>
                                            </div>
                                            <div style="text-align:right;">
                                                <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:30px;">ПОКУПАТЕЛЬ</div>
                                                <div style="border-top:1px solid #555; padding-top:8px; color:#999; font-size:12px;">@order.ContactName</div>
                                            </div>
                                        </div>
                                        <div style="background:#242424; border-radius:8px; padding:24px; margin-top:36px;">
                                            <div style="color:#666; font-size:10px; letter-spacing:1px; margin-bottom:10px;">ГАРАНТИЙНЫЕ ОБЯЗАТЕЛЬСТВА</div>
                                            <p style="color:#e0e0e0; font-size:14px; line-height:1.7; margin:0 0 12px 0;">
                                                ООО «RXXMRKT» гарантирует работоспособность приобретённого товара в течение <strong style="color:#D44177;">12 (двенадцати) месяцев</strong> с даты покупки.
                                            </p>
                                            <p style="color:#b0b0b0; font-size:13px; line-height:1.6; margin:0 0 12px 0;">
                                                Гарантия распространяется на дефекты, возникшие по вине производителя. Гарантийное обслуживание осуществляется в авторизованном сервисном центре.
                                            </p>
                                            <p style="color:#b0b0b0; font-size:13px; line-height:1.6; margin:0;">
                                                Гарантия не распространяется на механические повреждения, следы воздействия жидкости, а также на повреждения, вызванные неправильной эксплуатацией.
                                            </p>
                                        </div>
                                    </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 20px;">
                            <h3>У вас пока нет заказов</h3>
                            <a href="/catalog" class="cta-button" style="margin-top: 20px; display: inline-block;">Перейти в каталог</a>
                        </div>
                    }
                </div>

                <div class="service-card">
                    <h3>История заявок на ремонт</h3>
                    @if (Model.RepairRequests.Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 15px;">
                            @foreach (var repair in Model.RepairRequests.OrderByDescending(r => r.CreatedAt))
                            {
                                var repairStatusClass = repair.Status switch
                                {
                                    SmartphoneShop.Core.Enums.RepairStatus.New or
                                    SmartphoneShop.Core.Enums.RepairStatus.DeliveryToCenter or
                                    SmartphoneShop.Core.Enums.RepairStatus.AcceptedAtCenter or
                                    SmartphoneShop.Core.Enums.RepairStatus.InQueue or
                                    SmartphoneShop.Core.Enums.RepairStatus.Diagnostics or
                                    SmartphoneShop.Core.Enums.RepairStatus.RepairApproval => "status-neutral",
                                    SmartphoneShop.Core.Enums.RepairStatus.InRepair or
                                    SmartphoneShop.Core.Enums.RepairStatus.ReadyForPickup => "status-active",
                                    SmartphoneShop.Core.Enums.RepairStatus.Completed => "status-done",
                                    SmartphoneShop.Core.Enums.RepairStatus.Cancelled => "status-stopped",
                                    _ => "status-neutral"
                                };
                                var repairStatusText = repair.Status switch
                                {
                                    SmartphoneShop.Core.Enums.RepairStatus.New => "Новая",
                                    SmartphoneShop.Core.Enums.RepairStatus.DeliveryToCenter => "Доставка в центр",
                                    SmartphoneShop.Core.Enums.RepairStatus.AcceptedAtCenter => "Принят в центр",
                                    SmartphoneShop.Core.Enums.RepairStatus.InQueue => "В очереди",
                                    SmartphoneShop.Core.Enums.RepairStatus.Diagnostics => "Диагностика",
                                    SmartphoneShop.Core.Enums.RepairStatus.RepairApproval => "Ожидает одобрения",
                                    SmartphoneShop.Core.Enums.RepairStatus.InRepair => "В ремонте",
                                    SmartphoneShop.Core.Enums.RepairStatus.ReadyForPickup => "Готов к выдаче",
                                    SmartphoneShop.Core.Enums.RepairStatus.Completed => "Завершён",
                                    SmartphoneShop.Core.Enums.RepairStatus.Cancelled => "Отменён",
                                    _ => repair.Status.ToString()
                                };
                                <div style="padding: 24px; background: #1a1a1a; border-radius: 12px; border: 1px solid #2c2c2c;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                                        <div>
                                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                                <h4 style="margin: 0; font-size: 18px;">@repair.SmartphoneModel</h4>
                                                <span style="display: inline-block; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 500;"
                                                      class="@repairStatusClass">
                                                    @repairStatusText
                                                </span>
                                            </div>
                                            <p style="margin: 0 0 8px 0; color: #b0b0b0; font-size: 14px;">Создана: @repair.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                            <p style="margin: 0; color: #b0b0b0; font-size: 14px;">@repair.IssueDescription</p>
                                            @if (repair.EstimatedPrice.HasValue)
                                            {
                                                <p style="margin: 12px 0 0 0; font-size: 16px; font-weight: 600; color: #D44177;">Оценка: @repair.EstimatedPrice.Value.ToString("N0") BYN</p>
                                            }
                                            @if (!string.IsNullOrEmpty(repair.AdminNotes))
                                            {
                                                <div style="margin-top: 12px; padding: 12px 16px; background: rgba(212, 65, 119, 0.08); border-left: 3px solid #D44177; border-radius: 6px;">
                                                    <p style="margin: 0; font-size: 13px; color: #f0f0f0;"><strong>Мастер:</strong> @repair.AdminNotes</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 20px;">
                            <h3>У вас пока нет заявок на ремонт</h3>
                            <p style="color: #b0b0b0; margin: 20px 0;">Если у вас возникли проблемы с устройством — оставьте заявку</p>
                            <a href="/repair" class="cta-button">Мои заявки</a>
                        </div>
                    }
                </div>

                <div class="service-card">
                    <h3>Мои отзывы</h3>
                    @if (Model.Reviews.Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 15px;">
                            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                            {
                                <div style="padding: 24px; background: #1a1a1a; border-radius: 12px; border: 1px solid #2c2c2c;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                                        <div style="flex: 1;">
                                            <h4 style="margin: 0 0 12px 0; font-size: 18px;">@review.Smartphone.ModelName</h4>
                                            <div style="margin-bottom: 12px; display: flex; gap: 4px;">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="@(i <= review.Rating ? "#D44177" : "none")" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                                    </svg>
                                                }
                                            </div>
                                            <p style="margin: 0 0 12px 0; font-size: 15px; line-height: 1.6; overflow-wrap: break-word; word-break: break-word;">@review.Comment</p>
                                            <p style="margin: 0; color: #b0b0b0; font-size: 13px;">Оставлен @review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 20px;">
                            <h3>У вас пока нет отзывов</h3>
                            <p style="color: #b0b0b0; margin: 20px 0;">Оставьте первый отзыв на товар из каталога</p>
                            <a href="/catalog" class="cta-button">Перейти в каталог</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div id="editProfileModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
    <div style="max-width: 500px; width: 90%; margin: auto;">
        <div class="service-card" style="padding: 30px; background: #2c2c2c; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #3a3a3a;">
                <h3 style="margin: 0;">Редактировать профиль</h3>
                <button onclick="closeModal('editProfileModal')" style="background: none; border: none; color: #b0b0b0; cursor: pointer; font-size: 24px;">&times;</button>
            </div>
            
            <div id="editProfileSuccess" style="display: none; padding: 15px; margin-bottom: 20px; background: rgba(212, 65, 119, 0.1); border: 1px solid #D44177; border-radius: 8px; color: #D44177;">
                Данные успешно обновлены
            </div>
            
            <div id="editProfileError" style="display: none; padding: 15px; margin-bottom: 20px; background: rgba(100, 100, 100, 0.15); border: 1px solid #666; border-radius: 8px; color: #b0b0b0;">
                Произошла ошибка при сохранении
            </div>

            <form id="editProfileForm">
                @Html.AntiForgeryToken()
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label">ФИО</label>
                    <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
                </div>
                
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label">Телефон</label>
                    <input type="tel" name="phone" class="form-control" value="@(Model.Phone ?? "")" placeholder="Не указан" />
                </div>

                <div style="display: flex; gap: 10px; margin-top: 25px;">
                    <button type="submit" class="cta-button" id="editProfileSubmit" style="flex: 1;">Сохранить</button>
                    <button type="button" class="cta-button" style="flex: 1; background: #3a3a3a;" onclick="closeModal('editProfileModal')">Отмена</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="changePasswordModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
    <div style="max-width: 500px; width: 90%; margin: auto;">
        <div class="service-card" style="padding: 30px; background: #2c2c2c; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #3a3a3a;">
                <h3 style="margin: 0;">Изменить пароль</h3>
                <button onclick="closeModal('changePasswordModal')" style="background: none; border: none; color: #b0b0b0; cursor: pointer; font-size: 24px;">&times;</button>
            </div>
            
            <div id="changePasswordSuccess" style="display: none; padding: 15px; margin-bottom: 20px; background: rgba(212, 65, 119, 0.1); border: 1px solid #D44177; border-radius: 8px; color: #D44177;">
                Пароль успешно изменен
            </div>
            
            <div id="changePasswordError" style="display: none; padding: 15px; margin-bottom: 20px; background: rgba(100, 100, 100, 0.15); border: 1px solid #666; border-radius: 8px; color: #b0b0b0;">
                Ошибка
            </div>

            <form id="changePasswordForm">
                @Html.AntiForgeryToken()
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label">Текущий пароль</label>
                    <input type="password" name="currentPassword" class="form-control" required />
                </div>
                
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label">Новый пароль</label>
                    <input type="password" name="newPassword" class="form-control" required minlength="6" id="newPasswordInput" />
                </div>
                
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label">Подтвердите новый пароль</label>
                    <input type="password" name="confirmPassword" class="form-control" required minlength="6" id="confirmPasswordInput" />
                </div>

                <div id="passwordMismatch" style="display: none; padding: 10px; margin-bottom: 15px; background: rgba(100, 100, 100, 0.15); border: 1px solid #666; border-radius: 6px; color: #b0b0b0; font-size: 14px;">
                    Пароли не совпадают
                </div>

                <div style="display: flex; gap: 10px; margin-top: 25px;">
                    <button type="submit" class="cta-button" id="changePasswordSubmit" style="flex: 1;">Изменить пароль</button>
                    <button type="button" class="cta-button" style="flex: 1; background: #3a3a3a;" onclick="closeModal('changePasswordModal')">Отмена</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openModal(id) {
        document.getElementById(id).style.display = 'flex';
    }

    function closeModal(id) {
        document.getElementById(id).style.display = 'none';
        // Сброс сообщений
        var msg = document.getElementById(id).querySelector('[id$="Success"]');
        if (msg) msg.style.display = 'none';
        var err = document.getElementById(id).querySelector('[id$="Error"]');
        if (err) err.style.display = 'none';
    }

    // Закрытие по клику вне модального окна
    document.querySelectorAll('[id$="Modal"]').forEach(function(modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal(modal.id);
        });
    });

    // Обработка формы редактирования профиля
    document.getElementById('editProfileForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var formData = new FormData(this);
        
        var btn = document.getElementById('editProfileSubmit');
        btn.textContent = 'Сохранение...';
        btn.disabled = true;
        
        fetch('/account/updateprofile', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                document.getElementById('editProfileSuccess').style.display = 'block';
                document.getElementById('editProfileError').style.display = 'none';
                setTimeout(function() { location.reload(); }, 1000);
            } else {
                document.getElementById('editProfileError').style.display = 'block';
                document.getElementById('editProfileSuccess').style.display = 'none';
            }
        })
        .catch(function() {
            document.getElementById('editProfileError').style.display = 'block';
        })
        .finally(function() {
            btn.textContent = 'Сохранить';
            btn.disabled = false;
        });
    });

    // Обработка формы смены пароля
    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        var newPass = document.getElementById('newPasswordInput').value;
        var confirmPass = document.getElementById('confirmPasswordInput').value;
        
        if (newPass !== confirmPass) {
            document.getElementById('passwordMismatch').style.display = 'block';
            return;
        }
        document.getElementById('passwordMismatch').style.display = 'none';
        
        var formData = new FormData(this);
        var btn = document.getElementById('changePasswordSubmit');
        btn.textContent = 'Изменение...';
        btn.disabled = true;
        
        fetch('/account/changepassword', {
            method: 'POST',
            body: formData
        })
        .then(function(response) {
            if (response.ok || response.status === 302) {
                document.getElementById('changePasswordSuccess').style.display = 'block';
                document.getElementById('changePasswordError').style.display = 'none';
                setTimeout(function() { location.reload(); }, 1000);
            } else {
                return response.text().then(function(text) {
                    document.getElementById('changePasswordError').textContent = 'Ошибка: ' + text;
                    document.getElementById('changePasswordError').style.display = 'block';
                    document.getElementById('changePasswordSuccess').style.display = 'none';
                });
            }
        })
        .catch(function() {
            document.getElementById('changePasswordError').textContent = 'Произошла ошибка';
            document.getElementById('changePasswordError').style.display = 'block';
        })
        .finally(function() {
            btn.textContent = 'Изменить пароль';
            btn.disabled = false;
        });
    });
</script>