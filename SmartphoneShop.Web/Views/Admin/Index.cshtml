@using Microsoft.AspNetCore.Identity
@using SmartphoneShop.Core.Entities
@inject UserManager<AppUser> UserManager
@{
    ViewData["Title"] = "Панель администратора";
    var user = await UserManager.GetUserAsync(User);
    var userRoles = user != null ? await UserManager.GetRolesAsync(user) : Array.Empty<string>();
    bool HasRole(string role) => userRoles.Contains(role);
    bool IsAdmin = HasRole("Admin");
    bool IsProductAdmin = HasRole("ProductAdmin") || IsAdmin;
    bool IsRepairSpecialist = HasRole("RepairSpecialist") || IsAdmin;
    bool IsExpert = HasRole("Expert") || IsAdmin;
}

<style>
    .admin-dashboard {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }
    
    .stat-card {
        background: #1a1a1a;
        border: 1px solid #2c2c2c;
        border-radius: 12px;
        padding: 24px;
        transition: all 0.3s ease;
    }
    
    .stat-card:hover {
        border-color: #D44177;
        transform: translateY(-2px);
    }
    
    .stat-card .stat-icon {
        width: 48px;
        height: 48px;
        background: rgba(212, 65, 119, 0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }
    
    .stat-card .stat-icon svg {
        width: 24px;
        height: 24px;
        stroke: #D44177;
    }
    
    .stat-card .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #f0f0f0;
        margin-bottom: 4px;
    }
    
    .stat-card .stat-label {
        color: #888;
        font-size: 14px;
    }
    
    .stat-card a.stat-link {
        display: inline-block;
        margin-top: 12px;
        color: #D44177;
        font-size: 13px;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    
    .stat-card a.stat-link:hover {
        opacity: 0.8;
    }
    
    .stat-card a.stat-link svg {
        width: 14px;
        height: 14px;
        stroke: #D44177;
        vertical-align: middle;
        margin-right: 4px;
    }
    
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    
    .page-header h2 {
        margin: 0;
    }
</style>

<section>
    <div class="container">
        <div class="page-header">
            <h2 class="section-title">Панель администратора</h2>
        </div>

        <div class="admin-dashboard">
            @if (IsAdmin)
            {
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="stat-value">@ViewBag.UsersCount</div>
                    <div class="stat-label">Пользователей</div>
                    <a href="/admin/users" class="stat-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                        Управление
                    </a>
                </div>
            }

            @if (IsProductAdmin)
            {
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                            <line x1="12" y1="18" x2="12.01" y2="18"/>
                        </svg>
                    </div>
                    <div class="stat-value">@ViewBag.SmartphonesCount</div>
                    <div class="stat-label">Товаров</div>
                    <a href="/adminsmartphone" class="stat-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                        Управление
                    </a>
                </div>
            }

            @if (IsRepairSpecialist)
            {
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                        </svg>
                    </div>
                    <div class="stat-value">@ViewBag.RepairsCount</div>
                    <div class="stat-label">Ремонтов</div>
                    <a href="/adminrepairs" class="stat-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                        Управление
                    </a>
                </div>
            }

            @if (IsAdmin)
            {
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"/>
                            <circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                        </svg>
                    </div>
                    <div class="stat-value">@ViewBag.OrdersCount</div>
                    <div class="stat-label">Заказов</div>
                    <a href="/adminorders" class="stat-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                        Просмотр
                    </a>
                </div>
            }

            @if (IsAdmin || IsProductAdmin)
            {
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                            <polyline points="10 9 9 9 8 9"/>
                        </svg>
                    </div>
                    <div class="stat-label" style="margin-bottom:4px;">Отчёты</div>
                    <a href="/adminreports" class="stat-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                        Открыть
                    </a>
                </div>
            }
        </div>

    </div>
</section>