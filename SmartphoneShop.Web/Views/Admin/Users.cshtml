@model X.PagedList.IPagedList<SmartphoneShop.Core.Entities.AppUser>
@{
    ViewData["Title"] = "Управление пользователями";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
    var availableRoles = ViewBag.AvailableRoles as string[];

    var roleTranslations = new Dictionary<string, string>
    {
        { "Admin", "Администратор" },
        { "Expert", "Эксперт" },
        { "ProductAdmin", "Админ товаров" },
        { "RepairSpecialist", "Специалист ремонта" },
        { "User", "Пользователь" },
        { "Народный эксперт", "Народный эксперт" }
    };

    string GetRoleName(string role)
    {
        return roleTranslations.ContainsKey(role) ? roleTranslations[role] : role;
    }
}

<style>
    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table th {
        padding: 14px 16px;
        text-align: left;
        color: #888;
        font-weight: 500;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #2c2c2c;
    }

    .admin-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #2c2c2c;
        color: #f0f0f0;
    }

    .admin-table tr:last-child td {
        border-bottom: none;
    }

    .admin-table tr:hover {
        background: rgba(212, 65, 119, 0.05);
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(212, 65, 119, 0.15);
        color: #D44177;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-primary {
        background: #D44177;
        color: #fff;
    }

    .btn-primary:hover {
        background: #b83565;
    }

    .btn-danger {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
    }

    .btn-danger:hover {
        background: rgba(231, 76, 60, 0.25);
    }

    .btn-secondary {
        background: #2c2c2c;
        color: #f0f0f0;
        border: 1px solid #3a3a3a;
    }

    .btn-secondary:hover {
        background: #3a3a3a;
    }

    .actions-cell {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal-overlay.active {
        display: flex;
    }

    .modal-content {
        background: #1a1a1a;
        border: 1px solid #2c2c2c;
        border-radius: 12px;
        padding: 30px;
        max-width: 480px;
        width: 90%;
    }

    .modal-content h3 {
        margin: 0 0 20px 0;
        color: #f0f0f0;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        color: #888;
        font-size: 13px;
        font-weight: 500;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 10px 14px;
        background: #2c2c2c;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        color: #f0f0f0;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group select:focus {
        border-color: #D44177;
    }

    .form-group select option {
        background: #2c2c2c;
        color: #f0f0f0;
    }

    .form-hint {
        color: #666;
        font-size: 12px;
        margin-top: 4px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-actions button {
        flex: 1;
    }
</style>

<section>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 class="section-title" style="margin: 0;">Управление пользователями</h2>
            <a href="/admin/createuser" class="btn-sm btn-primary" style="padding: 10px 20px; font-size: 14px; text-decoration: none;">
                Создать пользователя
            </a>
        </div>

        <form method="get" action="/admin/users" style="margin-bottom: 20px;">
            <div style="display: flex; gap: 10px; max-width: 400px;">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Поиск по имени или email..." style="flex: 1; padding: 10px 14px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 8px; color: #f0f0f0; font-size: 14px; outline: none;" />
                <button type="submit" style="padding: 10px 20px; background: #D44177; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-size: 14px;">Найти</button>
                @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
                {
                    <a href="/admin/users" style="padding: 10px 20px; background: #2c2c2c; color: #f0f0f0; border: 1px solid #3a3a3a; border-radius: 8px; text-decoration: none; font-size: 14px;">Сбросить</a>
                }
            </div>
        </form>

        @if (TempData["Error"] != null)
        {
            <div style="padding: 15px; margin-bottom: 20px; background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; border-radius: 8px; color: #e74c3c;">
                @TempData["Error"]
            </div>
        }

        <div class="card" style="padding: 0; background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 12px; overflow: hidden;">
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Пользователь</th>
                            <th>Email</th>
                            <th>Роль</th>
                            <th style="width: 180px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@user.FullName</strong>
                                    <div style="color: #888; font-size: 12px; margin-top: 2px;">@user.CreatedAt.ToString("dd.MM.yyyy")</div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (userRoles != null && userRoles.ContainsKey(user.Id) && userRoles[user.Id].Any())
                                    {
                                        <span class="role-badge">@GetRoleName(userRoles[user.Id].First())</span>
                                    }
                                    else
                                    {
                                        <span style="color: #666; font-size: 13px;">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="/admin/edituser?id=@user.Id" class="btn-sm btn-secondary">Редактировать</a>
                                        @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != user.Id)
                                        {
                                            <form method="post" action="/admin/deleteuser" style="display: inline;" onsubmit="return confirm('Удалить пользователя @user.FullName?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn-sm btn-danger">Удалить</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@if (Model.PageCount > 1)
{
    <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; padding: 16px 0;">
        @if (Model.HasPreviousPage)
        {
            <a href="@Url.Action("Users", new { search = ViewBag.Search, page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">← Назад</a>
        }

        @for (int i = 1; i <= Model.PageCount; i++)
        {
            if (i == Model.PageNumber)
            {
                <span style="padding: 8px 12px; background: #D44177; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600;">@i</span>
            }
            else
            {
                <a href="@Url.Action("Users", new { search = ViewBag.Search, page = i, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">@i</a>
            }
        }

        @if (Model.HasNextPage)
        {
            <a href="@Url.Action("Users", new { search = ViewBag.Search, page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">Вперёд →</a>
        }

        <span style="color: #888; font-size: 13px; margin-left: 10px;">Страница @Model.PageNumber из @Model.PageCount | Всего: @Model.TotalItemCount</span>
    </div>
}
