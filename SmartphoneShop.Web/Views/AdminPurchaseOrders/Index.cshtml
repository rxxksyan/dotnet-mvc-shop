@model X.PagedList.IPagedList<SmartphoneShop.Core.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Заявки на покупку";
}

<style>
    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .admin-table th {
        padding: 14px 16px;
        text-align: left;
        color: #888;
        font-weight: 500;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #2c2c2c;
    }
    
    .admin-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #2c2c2c;
        color: #f0f0f0;
    }
    
    .admin-table tr:last-child td {
        border-bottom: none;
    }
    
    .admin-table tr:hover {
        background: rgba(212, 65, 119, 0.05);
    }
    
    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
    }
    
    .status-pending {
        background: rgba(241, 196, 15, 0.15);
        color: #f1c40f;
    }
    
    .status-processed {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
    }
    
    .btn-sm {
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .btn-success {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
    }
    
    .btn-success:hover {
        background: rgba(46, 204, 113, 0.25);
    }
    
    .filter-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }
    
    .filter-link {
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .filter-link.active {
        background: #D44177;
        color: #fff;
    }
    
    .filter-link:not(.active) {
        background: #2c2c2c;
        color: #f0f0f0;
        border: 1px solid #3a3a3a;
    }
    
    .filter-link:not(.active):hover {
        background: #3a3a3a;
    }
</style>

<section>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h2 class="section-title" style="margin: 0;">Заявки на покупку</h2>
        </div>

        @if (TempData["Message"] != null)
        {
            <div style="padding: 15px; margin-bottom: 20px; background: rgba(46,204,113,0.1); border: 1px solid #2ecc71; border-radius: 8px; color: #2ecc71;">
                @TempData["Message"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div style="padding: 15px; margin-bottom: 20px; background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; border-radius: 8px; color: #e74c3c;">
                @TempData["Error"]
            </div>
        }

        <div class="filter-bar">
            <a href="/adminpurchaseorders" class="filter-link @(ViewBag.Status == null ? "active" : "")">Все</a>
            <a href="/adminpurchaseorders?status=Pending" class="filter-link @(ViewBag.Status == "Pending" ? "active" : "")">Ожидание</a>
            <a href="/adminpurchaseorders?status=Processed" class="filter-link @(ViewBag.Status == "Processed" ? "active" : "")">Обработанные</a>
        </div>

        <div class="card" style="padding: 0; background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 12px; overflow: hidden;">
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>№</th>
                            <th>Пользователь</th>
                            <th>Смартфон</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th style="width: 150px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.User?.FullName</td>
                                <td>@order.Smartphone?.ModelName</td>
                                <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (order.Status == "Pending")
                                    {
                                        <span class="status-badge status-pending">Ожидание</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-processed">Обработана</span>
                                    }
                                </td>
                                <td>
                                    @if (order.Status == "Pending")
                                    {
                                        <form method="post" action="/adminpurchaseorders/markasprocessed" style="display: inline;" onsubmit="return confirm('Отметить как обработанную?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <button type="submit" class="btn-sm btn-success">Обработано</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2ecc71" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; padding: 16px 0;">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">← Назад</a>
                }

                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span style="padding: 8px 12px; background: #D44177; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600;">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.Status, page = i, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">@i</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">Вперёд →</a>
                }

                <span style="color: #888; font-size: 13px; margin-left: 10px;">Страница @Model.PageNumber из @Model.PageCount | Всего: @Model.TotalItemCount</span>
            </div>
        }
    </div>
</section>