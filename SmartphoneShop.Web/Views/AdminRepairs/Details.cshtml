@model SmartphoneShop.Core.Entities.RepairRequest

@{
    ViewData["Title"] = $"Заявка на ремонт #{Model.Id}";
}

<style>
    .detail-card {
        background: #1a1a1a;
        border: 1px solid #2c2c2c;
        border-radius: 12px;
        padding: 30px;
        max-width: 700px;
        margin: 0 auto;
    }
    .detail-card dt {
        color: #888;
        font-size: 13px;
        text-transform: uppercase;
        margin-top: 16px;
    }
    .detail-card dd {
        color: #f0f0f0;
        font-size: 15px;
        margin: 4px 0 0 0;
        padding-bottom: 12px;
        border-bottom: 1px solid #2c2c2c;
    }
    .detail-card dd:last-of-type {
        border-bottom: none;
    }
    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
    }
    .status-new { background: rgba(212, 65, 119, 0.15); color: #D44177; }
    .status-pending { background: rgba(212, 65, 119, 0.2); color: #D44177; }
    .status-in-progress { background: rgba(212, 65, 119, 0.25); color: #D44177; border: 1px solid rgba(212, 65, 119, 0.4); }
    .status-completed { background: rgba(255, 255, 255, 0.1); color: #f0f0f0; }
    .status-cancelled { background: rgba(100, 100, 100, 0.2); color: #888; }
    .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #D44177;
        text-decoration: none;
        font-size: 14px;
    }
    .back-link:hover { text-decoration: underline; }
</style>

<section>
    <div class="container">
        <a href="/adminrepairs" class="back-link">← Назад к списку</a>

        <div class="detail-card">
            <h2 style="margin: 0 0 8px 0; color: #f0f0f0;">Заявка на ремонт #@Model.Id</h2>
            <p style="color: #888; font-size: 13px; margin: 0 0 20px 0;">Создана: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>

            <dl>
                <dt>Пользователь</dt>
                <dd>@(Model.User?.FullName ?? Model.UserId)</dd>

                <dt>Модель устройства</dt>
                <dd>@Model.SmartphoneModel</dd>

                <dt>Серийный номер</dt>
                <dd>@Model.SerialNumber</dd>

                <dt>Описание проблемы</dt>
                <dd>@Model.IssueDescription</dd>

                <dt>Мастер</dt>
                <dd>@(Model.MasterUser?.FullName ?? "Не назначен")</dd>

                <dt>Статус</dt>
                <dd>
                    @{
                        var statusClass = Model.Status switch
                        {
                            SmartphoneShop.Core.Enums.RepairStatus.New => "status-new",
                            SmartphoneShop.Core.Enums.RepairStatus.DeliveryToCenter or
                                SmartphoneShop.Core.Enums.RepairStatus.AcceptedAtCenter or
                                SmartphoneShop.Core.Enums.RepairStatus.InQueue or
                                SmartphoneShop.Core.Enums.RepairStatus.Diagnostics or
                                SmartphoneShop.Core.Enums.RepairStatus.RepairApproval => "status-pending",
                            SmartphoneShop.Core.Enums.RepairStatus.InRepair or
                                SmartphoneShop.Core.Enums.RepairStatus.ReadyForPickup => "status-in-progress",
                            SmartphoneShop.Core.Enums.RepairStatus.Completed => "status-completed",
                            SmartphoneShop.Core.Enums.RepairStatus.Cancelled => "status-cancelled",
                            _ => ""
                        };
                        var statusText = Model.Status switch
                        {
                            SmartphoneShop.Core.Enums.RepairStatus.New => "Новая",
                            SmartphoneShop.Core.Enums.RepairStatus.DeliveryToCenter => "Доставка в центр",
                            SmartphoneShop.Core.Enums.RepairStatus.AcceptedAtCenter => "Принят в центр",
                            SmartphoneShop.Core.Enums.RepairStatus.InQueue => "В очереди",
                            SmartphoneShop.Core.Enums.RepairStatus.Diagnostics => "Диагностика",
                            SmartphoneShop.Core.Enums.RepairStatus.RepairApproval => "Ожидает одобрения",
                            SmartphoneShop.Core.Enums.RepairStatus.InRepair => "В ремонте",
                            SmartphoneShop.Core.Enums.RepairStatus.ReadyForPickup => "Готов к выдаче",
                            SmartphoneShop.Core.Enums.RepairStatus.Completed => "Завершён",
                            SmartphoneShop.Core.Enums.RepairStatus.Cancelled => "Отменён",
                            _ => Model.Status.ToString()
                        };
                    }
                    <span class="status-badge @statusClass">@statusText</span>
                </dd>

                <dt>Стоимость диагностики</dt>
                <dd>@(Model.EstimatedPrice.HasValue ? Model.EstimatedPrice.Value.ToString("N0") + " BYN" : "Не указана")</dd>

                @if (Model.ServicePrice.HasValue)
                {
                    <dt>Стоимость услуги мастера</dt>
                    <dd>@Model.ServicePrice.Value.ToString("N0") BYN</dd>
                }

                <dt>Комментарий мастера</dt>
                <dd>@(!string.IsNullOrEmpty(Model.AdminNotes) ? Model.AdminNotes : "—")</dd>

                @if (!string.IsNullOrEmpty(Model.NotesForClient))
                {
                    <dt>Заметки для клиента</dt>
                    <dd>@Model.NotesForClient</dd>
                }

                @if (Model.RepairSpareParts.Any())
                {
                    <dt>Необходимые запчасти</dt>
                    <dd>
                        <div style="margin-top: 8px;">
                            @foreach (var part in Model.RepairSpareParts)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #2c2c2c;">
                                    <div>
                                        <span style="color: #f0f0f0;">@part.SparePartName</span>
                                        @if (part.IsAvailable)
                                        {
                                            <span style="margin-left: 8px; font-size: 12px; color: #4CAF50;">В наличии</span>
                                        }
                                        else
                                        {
                                            <span style="margin-left: 8px; font-size: 12px; color: #D44177;">Ожидание ~@(part.EstimatedWaitDays ?? 0) дн.</span>
                                        }
                                    </div>
                                    <span style="color: #D44177; font-weight: 500;">@part.SparePartPrice.ToString("N0") BYN</span>
                                </div>
                            }
                            @{
                                var partsTotal = Model.RepairSpareParts.Sum(p => p.SparePartPrice);
                                var grandTotal = partsTotal + (Model.ServicePrice ?? 0);
                            }
                            <div style="display: flex; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px solid #3a3a3a; font-weight: 600;">
                                <span style="color: #f0f0f0;">Итого:</span>
                                <span style="color: #D44177;">@grandTotal.ToString("N0") BYN</span>
                            </div>
                        </div>
                    </dd>
                }

                <dt>Сообщение клиента</dt>
                <dd>@(!string.IsNullOrEmpty(Model.ClientMessage) ? Model.ClientMessage : "—")</dd>

                <dt>Решение клиента</dt>
                <dd>
                    @if (Model.ClientApproved == true)
                    {
                        <span style="color: #D44177;">✓ Одобрено</span>
                    }
                    else if (Model.ClientApproved == false)
                    {
                        <span style="color: #888;">✗ Отклонено</span>
                    }
                    else
                    {
                        <span style="color: #b0b0b0;">⏳ Ожидает решения</span>
                    }
                </dd>

                <dt>Обновлено</dt>
                <dd>@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <div style="margin-top: 24px;">
                <a href="/adminrepairs" class="cta-button" style="text-decoration: none;">Назад к списку</a>
            </div>
        </div>
    </div>
</section>
