@{
    ViewData["Title"] = "Отчёты";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-header h2 {
        margin: 0;
    }

    .report-buttons {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .report-card {
        background: #1a1a1a;
        border: 1px solid #2c2c2c;
        border-radius: 12px;
        padding: 32px;
        text-align: center;
        max-width: 500px;
        margin: 40px auto;
    }

    .report-card .icon {
        width: 64px;
        height: 64px;
        background: rgba(212, 65, 119, 0.1);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .report-card .icon svg {
        width: 32px;
        height: 32px;
        stroke: #D44177;
    }

    .report-card h3 {
        color: #f0f0f0;
        margin-bottom: 12px;
    }

    .report-card p {
        color: #888;
        font-size: 14px;
        margin-bottom: 24px;
        line-height: 1.5;
    }

    .report-card .report-list {
        text-align: left;
        color: #b0b0b0;
        font-size: 13px;
        margin-bottom: 24px;
        padding-left: 20px;
    }

    .report-card .report-list li {
        margin-bottom: 6px;
    }

    .download-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        background: #D44177;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .download-btn:hover {
        background: #c03a6a;
        transform: translateY(-1px);
    }

    .download-btn svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        fill: none;
    }
</style>

<section>
    <div class="container">
        <div class="page-header">
            <h2 class="section-title">Отчёты</h2>
        </div>

        <div class="report-card">
            <div class="icon">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
            </div>
            <h3>Скачать отчёт в Word</h3>
            <p>Полный отчёт по магазину rxxMRKT в формате .docx с таблицами и диаграммами</p>
            <ul class="report-list">
                <li>Обзор продаж (заказы, выручка, средний чек)</li>
                <li>Статусы заказов — круговая диаграмма</li>
                <li>Выручка по месяцам — столбчатая диаграмма</li>
                <li>Топ-10 товаров и брендов</li>
                <li>Товары без продаж</li>
                <li>Ремонты и топ-5 моделей для ремонта</li>
                <li>Новые пользователи по месяцам</li>
            </ul>
            <form method="post" action="/adminreports/download">
                @Html.AntiForgeryToken()
                <button type="submit" class="download-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Скачать отчёт
                </button>
            </form>
        </div>
    </div>
</section>
