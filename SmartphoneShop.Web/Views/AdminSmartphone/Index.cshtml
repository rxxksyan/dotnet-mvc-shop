@model X.PagedList.IPagedList<SmartphoneShop.Core.Entities.Smartphone>
@{
    ViewData["Title"] = "Управление товарами";
}

<style>
    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .admin-table th {
        padding: 14px 16px;
        text-align: left;
        color: #888;
        font-weight: 500;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #2c2c2c;
    }
    
    .admin-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #2c2c2c;
        color: #f0f0f0;
    }
    
    .admin-table tr:last-child td {
        border-bottom: none;
    }
    
    .admin-table tr:hover {
        background: rgba(212, 65, 119, 0.05);
    }
    
    .price-current {
        color: #D44177;
        font-weight: 600;
    }
    
    .price-old {
        color: #888;
        text-decoration: line-through;
        font-size: 12px;
        margin-left: 6px;
    }
    
    .btn-sm {
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }
    
    .btn-edit {
        background: #2c2c2c;
        color: #f0f0f0;
        border: 1px solid #3a3a3a;
    }
    
    .btn-edit:hover {
        background: #3a3a3a;
        color: #f0f0f0;
    }
    
    .btn-delete {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
    }
    
    .btn-delete:hover {
        background: rgba(231, 76, 60, 0.25);
    }
    
    .actions-cell {
        display: flex;
        gap: 8px;
    }
    
    .stock-badge {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
    }
    
    .out-of-stock {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
    }
</style>

<section>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap;">
            <h2 class="section-title" style="margin: 0;">Управление товарами</h2>
            <a href="/adminsmartphone/create" class="cta-button" style="flex-shrink: 0;">Добавить товар</a>
        </div>

        <form method="get" action="/adminsmartphone" style="margin-bottom: 20px;">
            <div style="display: flex; gap: 10px; max-width: 400px;">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Поиск по модели или бренду..." style="flex: 1; padding: 10px 14px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 8px; color: #f0f0f0; font-size: 14px; outline: none;" />
                <button type="submit" style="padding: 10px 20px; background: #D44177; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-size: 14px;">Найти</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search))
                {
                    <a href="/adminsmartphone" style="padding: 10px 20px; background: #2c2c2c; color: #f0f0f0; border: 1px solid #3a3a3a; border-radius: 8px; text-decoration: none; font-size: 14px;">Сбросить</a>
                }
            </div>
        </form>

        @if (TempData["Message"] != null)
        {
            <div style="padding: 15px; margin-bottom: 20px; background: rgba(46,204,113,0.1); border: 1px solid #2ecc71; border-radius: 8px; color: #2ecc71;">
                @TempData["Message"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div style="padding: 15px; margin-bottom: 20px; background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; border-radius: 8px; color: #e74c3c;">
                @TempData["Error"]
            </div>
        }

        <div class="card" style="padding: 0; background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 12px; overflow: hidden;">
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Модель</th>
                            <th>Бренд</th>
                            <th>Цена</th>
                            <th>RAM</th>
                            <th>Хранилище</th>
                            <th>Наличие</th>
                            <th style="width: 180px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phone in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@phone.ModelName</strong>
                                </td>
                                <td>@phone.Brand</td>
                                <td>
                                    <span class="price-current">@phone.Price.ToString("N0") BYN</span>
                                    @if (phone.OldPrice.HasValue)
                                    {
                                        <span class="price-old">@phone.OldPrice.Value.ToString("N0") BYN</span>
                                    }
                                </td>
                                <td>@(phone.RAM.HasValue ? phone.RAM + " ГБ" : "-")</td>
                                <td>@(phone.Storage.HasValue ? phone.Storage + " ГБ" : "-")</td>
                                <td>
                                    @if (phone.IsInStock)
                                    {
                                        <span class="stock-badge">В наличии</span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge out-of-stock">Нет в наличии</span>
                                    }
                                </td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="/adminsmartphone/edit/@phone.Id" class="btn-sm btn-edit">Редактировать</a>
                                        <form method="post" action="/adminsmartphone/delete/@phone.Id" style="display: inline;" onsubmit="return confirm('Удалить товар @phone.ModelName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-sm btn-delete">Удалить</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; padding: 16px 0;">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Index", new { search = ViewBag.Search, page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">← Назад</a>
                }

                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span style="padding: 8px 12px; background: #D44177; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600;">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { search = ViewBag.Search, page = i, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">@i</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Index", new { search = ViewBag.Search, page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">Вперёд →</a>
                }
            </div>
        }
    </div>
</section>