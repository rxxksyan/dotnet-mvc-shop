@model SmartphoneShop.Core.Entities.SparePart
@{
    ViewData["Title"] = "Добавить запчасть";
}

<section>
    <div class="container" style="max-width: 600px;">
        <h2 class="section-title">Добавить запчасть</h2>

        <div class="service-card" style="padding: 30px;">
            <form method="post" action="/adminspareparts/create">
                @Html.AntiForgeryToken()

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div style="padding: 12px 16px; background: rgba(231,76,60,0.1); border: 1px solid rgba(231,76,60,0.3); border-radius: 8px; margin-bottom: 20px; color: #e74c3c; font-size: 14px;">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 13px; text-transform: uppercase;">Название запчасти *</label>
                    <input type="text" name="Name" class="form-control" value="@Model.Name" required placeholder="Дисплей Samsung S24" style="width: 100%; padding: 12px 16px; background: #1a1a1a; border: 1px solid #3a3a3a; border-radius: 8px; color: #f0f0f0; font-size: 15px;" />
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 13px; text-transform: uppercase;">Цена (BYN) *</label>
                    <input type="number" name="Price" class="form-control" value="@Model.Price" required min="0.01" step="0.01" placeholder="0.00" style="width: 100%; padding: 12px 16px; background: #1a1a1a; border: 1px solid #3a3a3a; border-radius: 8px; color: #f0f0f0; font-size: 15px;" />
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 13px; text-transform: uppercase;">Количество на складе *</label>
                    <input type="number" name="Quantity" class="form-control" value="@Model.Quantity" required min="0" placeholder="0" style="width: 100%; padding: 12px 16px; background: #1a1a1a; border: 1px solid #3a3a3a; border-radius: 8px; color: #f0f0f0; font-size: 15px;" />
                </div>

                <div style="display: flex; gap: 10px; margin-top: 25px;">
                    <button type="submit" class="cta-button" style="flex: 1;">Добавить</button>
                    <a href="/adminspareparts" class="cta-button" style="flex: 1; background: #3a3a3a; text-align: center;">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</section>
