@model SmartphoneShop.Core.Entities.Cart
@{
    ViewData["Title"] = "Корзина";
}

<section>
    <div class="container">
        <h2 class="section-title">Корзина</h2>
        
        @if (TempData["Message"] != null)
        {
            <div class="service-card" style="margin-bottom: 30px;">
                <p>@TempData["Message"]</p>
            </div>
        }

        @if (Model.Items.Any())
        {
            <div class="cart-layout">
                <div class="cart-items">
                    <h3>Товары в корзине</h3>
                    <div class="cart-items-list">
                        @foreach (var item in Model.Items)
                        {
                            <div class="cart-item-row">
                                <div class="cart-item-info">
                                    <div class="cart-item-image">
                                        @if (!string.IsNullOrEmpty(item.Smartphone.ImageUrl))
                                        {
                                            <img src="@item.Smartphone.ImageUrl" alt="@item.Smartphone.ModelName" />
                                        }
                                        else
                                        {
                                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="1.5">
                                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                                <line x1="12" y1="18" x2="12.01" y2="18"></line>
                                            </svg>
                                        }
                                    </div>
                                    <div class="cart-item-details">
                                        <h3>@item.Smartphone.ModelName</h3>
                                        <p class="brand">@item.Smartphone.Brand</p>
                                        <p class="price">@item.Smartphone.Price.ToString("N0") BYN</p>
                                    </div>
                                </div>
                                <div class="cart-item-controls">
                                    <div class="quantity-controls">
                                        <form method="post" action="/cart/update" style="display: flex; align-items: center; gap: 8px;">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="qty-btn" @(item.Quantity <= 1 ? "disabled" : "")>−</button>
                                            <span class="qty-value">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="qty-btn">+</button>
                                        </form>
                                    </div>
                                    <p class="item-total">@((item.Smartphone.Price * item.Quantity).ToString("N0")) BYN</p>
                                    <form method="post" action="/cart/remove">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="remove-btn">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="cart-summary">
                    <h3>Итого</h3>
                    <div class="summary-card">
                        <p><strong>Товаров:</strong> @Model.TotalItems</p>
                        <p class="total-price">@Model.TotalAmount.ToString("N0") BYN</p>
                        <div class="summary-actions">
                            <a href="/order/checkout" class="cta-button">Оформить заказ</a>
                            <form method="post" action="/cart/clear">
                                <button type="submit" class="cta-button" style="background: #3a3a3a;">Очистить корзину</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="service-card" style="text-align: center; padding: 60px;">
                <h3>Корзина пуста</h3>
                <p style="margin: 20px 0;">Добавьте товары из каталога</p>
                <a href="/catalog" class="cta-button">Перейти в каталог</a>
            </div>
        }
    </div>
</section>
