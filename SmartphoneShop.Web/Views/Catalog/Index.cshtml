@model X.PagedList.IPagedList<SmartphoneShop.Core.Entities.Smartphone>
@{
    ViewData["Title"] = "Каталог";
}

<section>
    <div class="container">
        <h2 class="section-title">Каталог смартфонов</h2>
        
        <div class="filters">
            <form method="get" action="/catalog" style="display: contents;">
                <div class="filter-group" style="flex: 1; min-width: 180px;">
                    <label>Поиск</label>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Название, бренд..." style="width: 100%;" />
                </div>
                <div class="filter-group">
                    <label>Бренд</label>
                    <select name="brand">
                        <option value="">Все бренды</option>
                        @foreach (var brand in ViewBag.Brands as string[])
                        {
                            <option value="@brand" selected="@(brand == ViewBag.CurrentBrand)">@brand</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label>Цена от (BYN)</label>
                    <input type="number" name="minPrice" value="@ViewBag.MinPrice" placeholder="0" />
                </div>
                <div class="filter-group">
                    <label>Цена до (BYN)</label>
                    <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="200000" />
                </div>
                <div class="filter-group">
                    <label>ОЗУ</label>
                    <select name="ram">
                        <option value="">Любая</option>
                        <option value="4" selected="@((int?)ViewBag.Ram == 4)">4 ГБ</option>
                        <option value="6" selected="@((int?)ViewBag.Ram == 6)">6 ГБ</option>
                        <option value="8" selected="@((int?)ViewBag.Ram == 8)">8 ГБ</option>
                        <option value="12" selected="@((int?)ViewBag.Ram == 12)">12 ГБ</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Память</label>
                    <select name="storage">
                        <option value="">Любая</option>
                        <option value="64" selected="@(ViewBag.Storage == 64)">64 ГБ</option>
                        <option value="128" selected="@(ViewBag.Storage == 128)">128 ГБ</option>
                        <option value="256" selected="@(ViewBag.Storage == 256)">256 ГБ</option>
                        <option value="512" selected="@(ViewBag.Storage == 512)">512 ГБ</option>
                    </select>
                </div>
                <div class="filter-group" style="align-self: end;">
                    <label style="color: #f0f0f0; font-size: 14px;">Сортировка:</label>
                    <select name="sort" onchange="this.form.submit()">
                        <option value="newest" selected="@(ViewBag.Sort == null || ViewBag.Sort == "newest")">Новинки</option>
                        <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Сначала дешёвые</option>
                        <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Сначала дорогие</option>
                        <option value="name_asc" selected="@(ViewBag.Sort == "name_asc")">По названию (А-Я)</option>
                        <option value="name_desc" selected="@(ViewBag.Sort == "name_desc")">По названию (Я-А)</option>
                    </select>
                </div>
                <div class="filter-group" style="align-self: end;">
                    <button type="submit" class="cta-button" style="width: 100%;">Применить</button>
                </div>
            </form>
        </div>
        
        <div class="product-grid">
            @foreach (var phone in Model)
            {
                <a href="/product/details/@phone.Id" class="product-card @(!phone.IsInStock ? "out-of-stock" : "")">
                    <div class="product-image">
                        @if (!phone.IsInStock)
                        {
                            <div class="out-of-stock-overlay"></div>
                            <span class="out-of-stock-badge">Нет в наличии</span>
                        }
                        @if (!string.IsNullOrEmpty(phone.ImageUrl))
                        {
                            <img src="@phone.ImageUrl" alt="@phone.ModelName" />
                        }
                        else
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="1.5">
                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                <line x1="12" y1="18" x2="12.01" y2="18"></line>
                            </svg>
                        }
                    </div>
                    <div class="product-card-header">
                        <h3>@phone.ModelName</h3>
                        <div class="rating">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D44177" stroke="#D44177" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span>@(((double?)ViewBag.Ratings?[phone.Id])?.ToString("0.0") ?? "0.0")</span>
                        </div>
                    </div>
                    <p class="description">@(phone.Description?.Length > 80 ? phone.Description.Substring(0, 80) + "..." : phone.Description)</p>
                    <p class="specs">@phone.ScreenSize" • @(phone.RAM ?? 0) ГБ • @(phone.Storage ?? 0) ГБ</p>
                    <p class="price">@phone.Price.ToString("N0") BYN</p>
                    <div class="product-actions" onclick="event.preventDefault(); event.stopPropagation();">
                        <button type="button" class="cta-button" style="flex: 1;" onclick="addToCart(@phone.Id)" @(!phone.IsInStock ? "disabled" : "")>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                            В корзину
                        </button>
                        <button type="button" class="comparison-btn @(ViewBag.ComparisonIds != null && ((HashSet<int>)ViewBag.ComparisonIds).Contains(phone.Id) ? "in-comparison" : "")" style="width: 36px; height: 36px; border: none; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; background: @(ViewBag.ComparisonIds != null && ((HashSet<int>)ViewBag.ComparisonIds).Contains(phone.Id) ? "#D44177" : "#3a3a3a"); color: #f0f0f0; flex-shrink: 0;" data-id="@phone.Id" onclick="addToComparison(@phone.Id, this)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </button>
                    </div>
                </a>
            }
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 30px; padding: 20px 0;">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Index", new { brand = ViewBag.CurrentBrand, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, ram = ViewBag.Ram, storage = ViewBag.Storage, sort = ViewBag.Sort, search = ViewBag.Search, page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">← Назад</a>
                }

                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span style="padding: 8px 12px; background: #D44177; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600;">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { brand = ViewBag.CurrentBrand, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, ram = ViewBag.Ram, storage = ViewBag.Storage, sort = ViewBag.Sort, search = ViewBag.Search, page = i, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">@i</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Index", new { brand = ViewBag.CurrentBrand, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, ram = ViewBag.Ram, storage = ViewBag.Storage, sort = ViewBag.Sort, search = ViewBag.Search, page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">Вперёд →</a>
                }

                <span style="color: #888; font-size: 13px; margin-left: 10px;">Страница @Model.PageNumber из @Model.PageCount | Всего товаров: @Model.TotalItemCount</span>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function addToComparison(id, btn) {
            fetch('/comparison/add?smartphoneId=' + id, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(d => {
                    if (d.count >= 2) {
                        btn.classList.add('in-comparison');
                        btn.style.background = '#D44177';
                        setTimeout(function () { window.location.href = '/comparison'; }, 300);
                    } else {
                        btn.classList.add('in-comparison');
                        btn.style.background = '#D44177';
                    }
                })
                .catch(e => console.error(e));
        }
    </script>
}
