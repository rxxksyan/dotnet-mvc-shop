@using SmartphoneShop.Web.Helpers
@model SmartphoneShop.Core.Entities.ComparisonList
@{
    ViewData["Title"] = "Сравнение";
}

<section>
    <div class="container">
        <h2 class="section-title">Сравнение смартфонов</h2>
        
        @if (Model.Items.Any())
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; color: #f0f0f0;">
                    <thead>
                        <tr style="background: rgba(44, 44, 44, 0.6);">
                            <th style="padding: 20px; text-align: left; border-bottom: 2px solid rgba(212, 65, 119, 0.3);">Характеристика</th>
                            @foreach (var item in Model.Items)
                            {
                                <th style="padding: 20px; text-align: center; border-bottom: 2px solid rgba(212, 65, 119, 0.3); min-width: 200px;">
                                    <div>@item.Smartphone.ModelName</div>
                                    <form method="post" action="/comparison/remove" style="margin-top: 10px;">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="cta-button" style="padding: 6px 12px; font-size: 12px; background: #a7325c;">Удалить</button>
                                    </form>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background: rgba(44, 44, 44, 0.3);">
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Бренд</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@item.Smartphone.Brand</td>
                            }
                        </tr>
                        <tr>
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Цена</strong></td>
                            @{ var minPrice = Model.Items.Min(i => i.Smartphone.Price); }
                            @foreach (var item in Model.Items)
                            {
                                var isBest = item.Smartphone.Price == minPrice;
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a; @(isBest ? "background: rgba(212, 65, 119, 0.15); color: #D44177; font-weight: 600;" : "color: #D44177; font-weight: 600;")">
                                    @item.Smartphone.Price.ToString("N0") BYN
                                </td>
                            }
                        </tr>
                        <tr style="background: rgba(44, 44, 44, 0.3);">
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Экран</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@item.Smartphone.ScreenSize" @item.Smartphone.ScreenType</td>
                            }
                        </tr>
                        <tr>
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Разрешение</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@item.Smartphone.ScreenResolution</td>
                            }
                        </tr>
                        <tr style="background: rgba(44, 44, 44, 0.3);">
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Процессор</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@item.Smartphone.Processor</td>
                            }
                        </tr>
                        <tr>
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>ОЗУ</strong></td>
                            @{ var maxRam = Model.Items.Max(i => i.Smartphone.RAM ?? 0); }
                            @foreach (var item in Model.Items)
                            {
                                var isBest = item.Smartphone.RAM == maxRam && maxRam > 0;
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a; @(isBest ? "background: rgba(212, 65, 119, 0.15); color: #D44177; font-weight: 600;" : "")">@(item.Smartphone.RAM?.ToString() ?? "—") ГБ</td>
                            }
                        </tr>
                        <tr style="background: rgba(44, 44, 44, 0.3);">
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Память</strong></td>
                            @{ var maxStorage = Model.Items.Max(i => i.Smartphone.Storage ?? 0); }
                            @foreach (var item in Model.Items)
                            {
                                var isBest = item.Smartphone.Storage == maxStorage && maxStorage > 0;
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a; @(isBest ? "background: rgba(212, 65, 119, 0.15); color: #D44177; font-weight: 600;" : "")">@(item.Smartphone.Storage?.ToString() ?? "—") ГБ</td>
                            }
                        </tr>
                        <tr>
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Батарея</strong></td>
                            @{ var maxBattery = Model.Items.Max(i => i.Smartphone.BatteryCapacity ?? 0); }
                            @foreach (var item in Model.Items)
                            {
                                var isBest = item.Smartphone.BatteryCapacity == maxBattery && maxBattery > 0;
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a; @(isBest ? "background: rgba(212, 65, 119, 0.15); color: #D44177; font-weight: 600;" : "")">@(item.Smartphone.BatteryCapacity?.ToString() ?? "—") мАч</td>
                            }
                        </tr>
                        <tr style="background: rgba(44, 44, 44, 0.3);">
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Основная камера</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@item.Smartphone.MainCamera</td>
                            }
                        </tr>
                        <tr>
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Фронтальная камера</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@item.Smartphone.FrontCamera</td>
                            }
                        </tr>
                        <tr style="background: rgba(44, 44, 44, 0.3);">
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>NFC</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@(item.Smartphone.NFC ? "Да" : "Нет")</td>
                            }
                        </tr>
                        <tr>
                            <td style="padding: 15px; border-bottom: 1px solid #3a3a3a;"><strong>Беспроводная зарядка</strong></td>
                            @foreach (var item in Model.Items)
                            {
                                <td style="padding: 15px; text-align: center; border-bottom: 1px solid #3a3a3a;">@(item.Smartphone.WirelessCharging ? "Да" : "Нет")</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
            
            @if (ViewBag.ExpertOpinions != null && ((List<SmartphoneShop.Core.Entities.ExpertOpinion>)ViewBag.ExpertOpinions).Any())
            {
                <div class="card" style="padding: 30px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px; margin-top: 30px;">
                    <h3 style="margin: 0 0 20px 0; text-align: center;">Мнения экспертов</h3>
                    <div style="display: flex; flex-direction: column; gap: 20px;">
                        @foreach (var opinion in ViewBag.ExpertOpinions)
                        {
                            <div style="padding: 20px; background: #1a1a1a; border-radius: 10px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <strong style="color: #D44177;">@opinion.Expert?.FullName</strong>
                                    <span style="color: #b0b0b0; font-size: 13px;">@opinion.CreatedAt.ToString("dd.MM.yyyy")</span>
                                </div>
                                <p style="margin: 0 0 10px 0; color: #f0f0f0;">@FormatHelper.FormatOpinionText(opinion.Text)</p>
                                @if (!string.IsNullOrEmpty(opinion.VideoUrl))
                                {
                                    <a href="@opinion.VideoUrl" target="_blank" rel="noopener noreferrer" style="color: #D44177; text-decoration: none; font-size: 14px;">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;">
                                            <polygon points="5 3 19 12 5 21 5 3"/>
                                        </svg>
                                        Смотреть видео
                                    </a>
                                }
                                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Expert") || (User.Identity.Name != null && opinion.Expert?.UserName == User.Identity.Name)))
                                {
                                    <div style="margin-top: 10px; display: flex; gap: 10px;">
                                    <a href="/ExpertOpinion/Edit/@opinion.Id" style="padding: 5px 10px; background: #3a3a3a; color: #f0f0f0; text-decoration: none; border-radius: 5px; font-size: 13px;">Редактировать</a>
                                        <form method="post" action="/ExpertOpinion/Delete/@opinion.Id" style="display: inline;" onsubmit="return confirm('Удалить мнение?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" style="padding: 5px 10px; background: #3a3a3a; color: #f0f0f0; border: none; border-radius: 5px; cursor: pointer; font-size: 13px;">Удалить</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (ViewBag.CanAddOpinion == true && Model.Items.Count >= 2)
            {
                <div class="card" style="padding: 30px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px; margin-top: 20px;">
                    <h3 style="margin: 0 0 20px 0; text-align: center;">Добавить мнение</h3>
                    <form method="post" action="/expertopinion/create">
                        @Html.AntiForgeryToken()
                        @{
                            var items = Model.Items.ToList();
                            var id1 = Math.Min(items[0].SmartphoneId, items[1].SmartphoneId);
                            var id2 = Math.Max(items[0].SmartphoneId, items[1].SmartphoneId);
                        }
                        <input type="hidden" name="smartphoneId1" value="@id1" />
                        <input type="hidden" name="smartphoneId2" value="@id2" />
                        
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label class="form-label">Текст мнения *</label>
                            <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                                <button type="button" onclick="formatOpinionText('bold')" style="padding: 6px 12px; background: #3a3a3a; color: #f0f0f0; border: 1px solid #555; border-radius: 4px; cursor: pointer; font-weight: bold;">B</button>
                                <button type="button" onclick="formatOpinionText('italic')" style="padding: 6px 12px; background: #3a3a3a; color: #f0f0f0; border: 1px solid #555; border-radius: 4px; cursor: pointer; font-style: italic;">I</button>
                                <button type="button" onclick="formatOpinionText('strike')" style="padding: 6px 12px; background: #3a3a3a; color: #f0f0f0; border: 1px solid #555; border-radius: 4px; cursor: pointer; text-decoration: line-through;">S</button>
                            </div>
                            <textarea id="opinionTextArea" name="text" class="form-control" required rows="4" placeholder="Поделитесь своим мнением о сравнении этих моделей..."></textarea>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label class="form-label">Ссылка на видео</label>
                            <input type="url" name="videoUrl" class="form-control" placeholder="https://youtube.com/..." />
                        </div>

                        <button type="submit" class="cta-button" style="width: 100%;">Опубликовать мнение</button>
                    </form>
                </div>
            }

            <div style="margin-top: 30px; text-align: center;">
                <form method="post" action="/comparison/clear">
                    <button type="submit" class="cta-button" style="background: #3a3a3a;">Очистить сравнение</button>
                </form>
            </div>
        }
        else
        {
            <div class="service-card" style="text-align: center; padding: 60px;">
                <h3>Список сравнения пуст</h3>
                <p style="margin: 20px 0;">Добавьте смартфоны для сравнения</p>
                <a href="/catalog" class="cta-button">Перейти в каталог</a>
            </div>
        }
    </div>
</section>

<script>
function formatOpinionText(command) {
    const textarea = document.getElementById('opinionTextArea');
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const selectedText = textarea.value.substring(start, end);
    let wrapped = selectedText;

    switch(command) {
        case 'bold':
            wrapped = '**' + selectedText + '**';
            break;
        case 'italic':
            wrapped = '*' + selectedText + '*';
            break;
        case 'strike':
            wrapped = '~~' + selectedText + '~~';
            break;
    }

    textarea.setRangeText(wrapped, start, end, 'end');
    textarea.focus();
}
</script>