@model IEnumerable<SmartphoneShop.Core.Entities.Favorite>
@{
    ViewData["Title"] = "Избранное";
}

<section>
    <div class="container">
        <h2 class="section-title">Избранное</h2>
        
        @if (TempData["Message"] != null)
        {
            <div class="service-card" style="background: rgba(46, 204, 113, 0.2); border-color: #2ecc71; margin-bottom: 30px;">
                <p style="color: #2ecc71;">@TempData["Message"]</p>
            </div>
        }

        @if (Model.Any())
        {
            <div class="product-grid">
                @foreach (var favorite in Model)
                {
                    <div class="product-card">
                        <div class="product-image">
                            @if (!string.IsNullOrEmpty(favorite.Smartphone.ImageUrl))
                            {
                                <img src="@favorite.Smartphone.ImageUrl" alt="@favorite.Smartphone.ModelName" />
                            }
                            else
                            {
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="1.5">
                                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                                </svg>
                            }
                        </div>
                        <h3>@favorite.Smartphone.ModelName</h3>
                        <p class="brand">@favorite.Smartphone.Brand</p>
                        <p class="specs">@favorite.Smartphone.ScreenSize" • @(favorite.Smartphone.RAM ?? 0) ГБ • @(favorite.Smartphone.Storage ?? 0) ГБ</p>
                        <p class="price">@favorite.Smartphone.Price.ToString("N0") BYN</p>
                        <div class="product-actions">
                            <a href="/product/details/@favorite.SmartphoneId" class="cta-button">Подробнее</a>
                            <form method="post" action="/favorites/remove" style="flex: 1;">
                                <input type="hidden" name="id" value="@favorite.Id" />
                                <button type="submit" class="cta-button" style="background: #3a3a3a;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="service-card" style="text-align: center; padding: 60px;">
                <h3>Избранное пусто</h3>
                <p style="margin: 20px 0;">Добавьте смартфоны в избранное</p>
                <a href="/catalog" class="cta-button">Перейти в каталог</a>
            </div>
        }
    </div>
</section>