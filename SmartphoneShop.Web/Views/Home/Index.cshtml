@model IEnumerable<SmartphoneShop.Core.Entities.Smartphone>
@{
    ViewData["Title"] = "Главная";
}

<section class="hero">
    <div class="container">
        <h1>rxx<span>MRKT</span></h1>
        <p>Магазин, сравнение и ремонт смартфонов</p>
        <a href="/catalog" class="cta-button">Перейти в каталог</a>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">Популярные смартфоны</h2>
        <div class="product-grid">
            @foreach (var phone in Model)
            {
                <a href="/product/details/@phone.Id" class="product-card @(phone.Quantity <= 0 ? "out-of-stock" : "")">
                    <div class="product-image">
                        @if (phone.Quantity <= 0)
                        {
                            <div class="out-of-stock-overlay"></div>
                            <span class="out-of-stock-badge">Нет в наличии</span>
                        }
                        @if (phone.OldPrice > 0 && phone.OldPrice != phone.Price)
                        {
                            <span style="position: absolute; top: 8px; right: 8px; background: #D44177; color: #fff; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; z-index: 5;">-@((int)((1m - phone.Price / phone.OldPrice.Value) * 100m))%</span>
                        }
                        @if (!string.IsNullOrEmpty(phone.ImageUrl))
                        {
                            <img src="@phone.ImageUrl" alt="@phone.ModelName" />
                        }
                        else
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="1.5">
                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                <line x1="12" y1="18" x2="12.01" y2="18"></line>
                            </svg>
                        }
                    </div>
                    <div class="product-card-header">
                        <h3>@phone.ModelName</h3>
                        <div class="rating">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D44177" stroke="#D44177" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span>@(((double?)ViewBag.Ratings?[phone.Id])?.ToString("0.0") ?? "0.0")</span>
                        </div>
                    </div>
                    <p class="description" style="height: 18px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@phone.Description</p>
                    <p class="specs">@phone.ScreenSize" • @(phone.RAM ?? 0) ГБ • @(phone.Storage ?? 0) ГБ</p>
                    <p class="price">@phone.Price.ToString("N0") BYN</p>
                    <div class="product-actions" onclick="event.preventDefault(); event.stopPropagation();">
                        <button type="button" class="cta-button" style="flex: 1;" onclick="addToCart(@phone.Id)" @(phone.Quantity <= 0 ? "disabled" : "")>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                            В корзину
                        </button>
                        <button type="button" class="comparison-btn @(ViewBag.ComparisonIds != null && ((HashSet<int>)ViewBag.ComparisonIds).Contains(phone.Id) ? "in-comparison" : "")" style="width: 36px; height: 36px; border: none; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; background: @(ViewBag.ComparisonIds != null && ((HashSet<int>)ViewBag.ComparisonIds).Contains(phone.Id) ? "#D44177" : "#3a3a3a"); color: #f0f0f0; flex-shrink: 0;" data-id="@phone.Id" onclick="addToComparison(@phone.Id, this)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </button>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
