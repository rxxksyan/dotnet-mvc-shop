@model X.PagedList.IPagedList<SmartphoneShop.Core.Entities.Order>
@{
    ViewData["Title"] = "История заказов";
}

<section>
    <div class="container">
        <h2 class="section-title">История заказов</h2>

        @if (TempData["Message"] != null)
        {
            <div class="service-card" style="margin-bottom: 30px; border-color: #2ecc71;">
                <p style="color: #2ecc71;">@TempData["Message"]</p>
            </div>
        }

        @if (Model.Any())
        {
            @functions {
                string StatusRus(SmartphoneShop.Core.Enums.OrderStatus s) => s switch {
                    SmartphoneShop.Core.Enums.OrderStatus.Pending => "Оформлен",
                    SmartphoneShop.Core.Enums.OrderStatus.Confirmed => "Подтверждён",
                    SmartphoneShop.Core.Enums.OrderStatus.Shipped => "Отправлен",
                    SmartphoneShop.Core.Enums.OrderStatus.Delivered => "Доставлен",
                    SmartphoneShop.Core.Enums.OrderStatus.Cancelled => "Отменён",
                    _ => "Оформлен"
                };
            }
            <div style="display: flex; flex-direction: column; gap: 15px;">
                @foreach (var order in Model.OrderByDescending(o => o.CreatedAt))
                {
                    <div class="card" style="padding: 20px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h4 style="margin: 0 0 8px 0;">Заказ #@order.Id</h4>
                                <p style="margin: 0; color: #b0b0b0; font-size: 14px;">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                            <div style="text-align: right;">
                                <span class="badge @(order.Status == SmartphoneShop.Core.Enums.OrderStatus.Delivered ? "status-delivered" : order.Status == SmartphoneShop.Core.Enums.OrderStatus.Cancelled ? "status-cancelled" : "status-pending")" style="margin-bottom: 8px; border-radius: 20px; padding: 6px 14px;">@StatusRus(order.Status)</span>
                                <p style="margin: 8px 0 0 0; font-size: 20px; font-weight: bold; color: #D44177;">@order.TotalAmount.ToString("N0") BYN</p>
                            </div>
                        </div>
                        <button type="button" style="background: none; border: none; color: #b0b0b0; cursor: pointer; padding: 8px 0; margin-top: 10px; width: 100%; text-align: left;" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'; this.textContent = this.textContent.includes('Подробнее') ? 'Скрыть детали' : 'Подробнее о заказе';">
                            <span>▼ Подробнее о заказе</span>
                        </button>
                        <div style="display: none; padding-top: 15px; margin-top: 15px; border-top: 1px solid #3a3a3a;">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px;">
                                <div>
                                    <span style="color: #b0b0b0; font-size: 13px;">Способ:</span>
                                    <p style="margin: 2px 0 0 0;">@(order.DeliveryType == SmartphoneShop.Core.Enums.DeliveryType.Pickup ? "Самовывоз" : "Доставка")</p>
                                </div>
                                <div>
                                    <span style="color: #b0b0b0; font-size: 13px;">@(order.DeliveryType == SmartphoneShop.Core.Enums.DeliveryType.Pickup ? "Пункт" : "Адрес")</span>
                                    <p style="margin: 2px 0 0 0;">@order.DeliveryAddress</p>
                                </div>
                                <div>
                                    <span style="color: #b0b0b0; font-size: 13px;">Получатель:</span>
                                    <p style="margin: 2px 0 0 0;">@order.ContactName</p>
                                </div>
                            </div>
                            <div>
                                <span style="color: #b0b0b0; font-size: 13px;">Товары:</span>
                                @foreach (var item in order.Items)
                                {
                                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #3a3a3a;">
                                        <span>@item.Smartphone.ModelName × @item.Quantity</span>
                                        <span style="color: #D44177;">@item.TotalPrice.ToString("N0") BYN</span>
                                    </div>
                                }
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                                <strong>Итого:</strong>
                                <strong style="color: #D44177; font-size: 18px;">@order.TotalAmount.ToString("N0") BYN</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.PageCount > 1)
            {
                <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; padding: 16px 0;">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("History", new { page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">← Назад</a>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <span style="padding: 8px 12px; background: #D44177; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600;">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("History", new { page = i, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">@i</a>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("History", new { page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">Вперёд →</a>
                    }

                    <span style="color: #888; font-size: 13px; margin-left: 10px;">Страница @Model.PageNumber из @Model.PageCount | Всего заказов: @Model.TotalItemCount</span>
                </div>
            }
        }
        else
        {
            <div class="service-card" style="text-align: center; padding: 60px;">
                <h3>У вас пока нет заказов</h3>
                <p style="margin: 20px 0;">Начните покупки прямо сейчас!</p>
                <a href="/catalog" class="cta-button">Перейти в каталог</a>
            </div>
        }
    </div>
</section>