@model SmartphoneShop.Core.Entities.Order
@{
    ViewData["Title"] = "Заказ #" + Model.Id;
}

<section>
    <div class="container">
        <div style="max-width: 600px; margin: 40px auto;">
            <div class="card" style="border-radius: 16px; background: #2c2c2c; border: 1px solid #3a3a3a; padding: 30px; margin-bottom: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 20px; border-bottom: 1px solid #3a3a3a;">
                    <div>
                        <h3 style="margin: 0; font-size: 20px;">Заказ #@Model.Id</h3>
                        <p style="margin: 5px 0 0 0; color: #b0b0b0; font-size: 14px;">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                    </div>
                    <span class="badge status-pending" style="padding: 8px 16px; font-size: 14px; border-radius: 20px;">@(Model.Status == SmartphoneShop.Core.Enums.OrderStatus.Pending ? "Оформлен" : Model.Status == SmartphoneShop.Core.Enums.OrderStatus.Confirmed ? "Подтверждён" : Model.Status == SmartphoneShop.Core.Enums.OrderStatus.Shipped ? "Отправлен" : Model.Status == SmartphoneShop.Core.Enums.OrderStatus.Delivered ? "Доставлен" : "Отменён")</span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 20px; border-bottom: 1px solid #3a3a3a;">
                    <span style="color: #b0b0b0;">@Model.Items.Count() товар(ов)</span>
                    <span style="font-size: 24px; font-weight: bold; color: #D44177;">@Model.TotalAmount.ToString("N0") BYN</span>
                </div>

                <div style="margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; padding: 10px 0;">
                        <span style="color: #b0b0b0;">Адрес</span>
                        <span>@Model.DeliveryAddress</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 10px 0;">
                        <span style="color: #b0b0b0;">Телефон</span>
                        <span>@Model.ContactPhone</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 10px 0;">
                        <span style="color: #b0b0b0;">Получатель</span>
                        <span>@Model.ContactName</span>
                    </div>
                </div>
            </div>

            <div class="card" style="border-radius: 16px; background: #2c2c2c; border: 1px solid #3a3a3a; padding: 25px; margin-bottom: 30px;">
                <h4 style="margin: 0 0 20px 0;">Товары в заказе</h4>
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    @foreach (var item in Model.Items)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px; background: #1a1a1a; border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                @if (!string.IsNullOrEmpty(item.Smartphone?.ImageUrl))
                                {
                                    <img src="@item.Smartphone.ImageUrl" alt="@item.Smartphone.ModelName" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" />
                                }
                                <div>
                                    <strong>@(item.Smartphone?.ModelName ?? "Товар")</strong>
                                    <p style="margin: 5px 0 0 0; color: #b0b0b0; font-size: 14px;">× @item.Quantity</p>
                                </div>
                            </div>
                            <strong style="color: #D44177;">@item.TotalPrice.ToString("N0") BYN</strong>
                        </div>
                    }
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a href="/order/history" class="cta-button">Мои заказы</a>
                <a href="/catalog" class="cta-button" style="background: #3a3a3a;">Продолжить покупки</a>
            </div>
        </div>
    </div>
</section>