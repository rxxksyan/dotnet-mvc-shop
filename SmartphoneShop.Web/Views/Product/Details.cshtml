@model SmartphoneShop.Core.Entities.Smartphone
@{
    ViewData["Title"] = Model.ModelName;
}

<section>
    <div class="container">
        <div class="product-detail">
            <div class="product-detail-image" id="imageGallery">
                @{
                    var allUrls = new List<string>();
                    if (!string.IsNullOrEmpty(Model.ImageUrls))
                    {
                        try { allUrls = System.Text.Json.JsonSerializer.Deserialize<string[]>(Model.ImageUrls)?.ToList() ?? new(); } catch { }
                    }
                    if (!string.IsNullOrEmpty(Model.ImageUrl) && !allUrls.Contains(Model.ImageUrl))
                        allUrls.Insert(0, Model.ImageUrl);
                }
                @if (allUrls.Count > 0)
                {
                    <div class="main-image-wrapper">
                        <img id="mainImage" src="@allUrls[0]" alt="@Model.ModelName" onclick="openLightbox()" />
                        @if (allUrls.Count > 1)
                        {
                            <button class="nav-arrow prev" onclick="navigateImage(-1)" type="button">&#10094;</button>
                            <button class="nav-arrow next" onclick="navigateImage(1)" type="button">&#10095;</button>
                        }
                    </div>
                    if (allUrls.Count > 1)
                    {
                        <div class="thumb-gallery">
                            @for (int i = 0; i < allUrls.Count; i++)
                            {
                                <img src="@allUrls[i]" class="@(i == 0 ? "active" : "")" onclick="setImage(@i)" />
                            }
                        </div>
                    }
                }
                else
                {
                    <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="1">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                    </svg>
                }
            </div>
            <div class="product-detail-info">
                <h1 class="product-title">@Model.Brand @Model.ModelName</h1>
                @if (!Model.IsInStock)
                {
                    <div style="display: inline-block; background: rgba(100,100,100,0.3); color: #b0b0b0; padding: 4px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; margin-bottom: 12px;">Нет в наличии</div>
                }
                <div class="product-detail-price">
                    @Model.Price.ToString("N0") BYN
                </div>
                @if (Model.OldPrice.HasValue)
                {
                    <div class="product-detail-old-price">
                        @Model.OldPrice.Value.ToString("N0") BYN
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="product-detail-description">
                        <p>@Model.Description</p>
                    </div>
                }
                <div class="product-detail-actions">
                    <button type="button" class="cta-button" onclick="addToCart(@Model.Id)" @(!Model.IsInStock ? "disabled" : "")>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        В корзину
                    </button>
                    <button type="button" class="cta-button comparison-btn" onclick="addToComparisonFromDetail(@Model.Id)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                        Сравнить
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="button" class="heart-btn @(ViewBag.IsFavorite ? "active" : "")" onclick="toggleFavoriteDetail(this, @Model.Id)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="@(ViewBag.IsFavorite ? "#D44177" : "none")" stroke="#D44177" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button>
                    }
                </div>
            </div>
        </div>
        
        <div class="specs-table" style="margin-top: 30px;">
            <h3>Характеристики</h3>
            <table>
                @if (Model.ScreenSize.HasValue) { <tr><td>Экран (диагональ)</td><td>@Model.ScreenSize"</td></tr> }
                @if (!string.IsNullOrEmpty(Model.ScreenResolution)) { <tr><td>Разрешение</td><td>@Model.ScreenResolution</td></tr> }
                @if (!string.IsNullOrEmpty(Model.ScreenType)) { <tr><td>Тип экрана</td><td>@Model.ScreenType</td></tr> }
                @if (Model.RAM.HasValue) { <tr><td>Оперативная память</td><td>@Model.RAM ГБ</td></tr> }
                @if (Model.Storage.HasValue) { <tr><td>Встроенная память</td><td>@Model.Storage ГБ</td></tr> }
                @if (!string.IsNullOrEmpty(Model.Processor)) { <tr><td>Процессор</td><td>@Model.Processor</td></tr> }
                @if (!string.IsNullOrEmpty(Model.MainCamera)) { <tr><td>Основная камера</td><td>@Model.MainCamera</td></tr> }
                @if (!string.IsNullOrEmpty(Model.FrontCamera)) { <tr><td>Фронтальная камера</td><td>@Model.FrontCamera</td></tr> }
                @if (!string.IsNullOrEmpty(Model.OS)) { <tr><td>ОС</td><td>@Model.OS</td></tr> }
                @if (Model.BatteryCapacity.HasValue) { <tr><td>Батарея</td><td>@Model.BatteryCapacity mAh</td></tr> }
                @if (Model.Weight.HasValue) { <tr><td>Вес</td><td>@Model.Weight г</td></tr> }
                <tr><td>NFC</td><td>@(Model.NFC ? "Да" : "Нет")</td></tr>
                <tr><td>Беспроводная зарядка</td><td>@(Model.WirelessCharging ? "Да" : "Нет")</td></tr>
                @if (!string.IsNullOrEmpty(Model.WaterResistance)) { <tr><td>Влагозащита</td><td>@Model.WaterResistance</td></tr> }
                @if (!string.IsNullOrEmpty(Model.Colors))
                {
                    <tr>
                        <td>Цвета</td>
                        <td>
                            @try {
                                var colors = System.Text.Json.JsonSerializer.Deserialize<string[]>(Model.Colors);
                                if (colors != null && colors.Length > 0)
                                {
                                    foreach (var color in colors)
                                    {
                                        <span style="display: inline-block; padding: 4px 8px; background: #3a3a3a; border-radius: 4px; margin-right: 6px; font-size: 13px;">@color</span>
                                    }
                                }
                            } catch { }
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h3 class="section-title">Отзывы</h3>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            var hasReview = (bool)ViewBag.UserHasReview;
            var reviewId = ViewBag.UserReviewId as int?;
            var reviewComment = ViewBag.UserReviewComment as string;
            var reviewRating = ViewBag.UserReviewRating as int?;
            <div class="service-card" style="margin-bottom: 24px; max-width: 600px; margin-left: auto; margin-right: auto;">
                <h4 style="margin-bottom: 16px; color: #f0f0f0; text-align: center;">@(hasReview ? "Редактировать отзыв" : "Оставить отзыв")</h4>
                <form method="post" action="/product/@(hasReview ? "updatereview" : "addreview")" id="reviewForm">
                    <input type="hidden" name="smartphoneId" value="@Model.Id" />
                    @if (hasReview) { <input type="hidden" name="reviewId" value="@reviewId" /> }
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>Оценка</label>
                        <div class="rating-select" style="display: flex; gap: 8px;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="star" data-value="@i" onclick="setRating(@i)" style="cursor: pointer; font-size: 32px; color: #3a3a3a;">★</span>
                            }
                        </div>
                        <input type="hidden" name="rating" id="ratingValue" value="@(reviewRating ?? 5)" />
                    </div>
                    <div class="form-group">
                        <label for="comment">Комментарий</label>
                        <div style="display:flex;gap:8px;margin-bottom:8px;">
                            <button type="button" onclick="formatReviewText('bold')" style="padding:6px 12px;background:#3a3a3a;color:#f0f0f0;border:1px solid #555;border-radius:4px;cursor:pointer;font-weight:bold;">B</button>
                            <button type="button" onclick="formatReviewText('italic')" style="padding:6px 12px;background:#3a3a3a;color:#f0f0f0;border:1px solid #555;border-radius:4px;cursor:pointer;font-style:italic;">I</button>
                            <button type="button" onclick="formatReviewText('strike')" style="padding:6px 12px;background:#3a3a3a;color:#f0f0f0;border:1px solid #555;border-radius:4px;cursor:pointer;text-decoration:line-through;">S</button>
                        </div>
                        <textarea name="comment" id="reviewComment" class="form-control" rows="4" placeholder="Поделитесь своим мнением о товаре..." required>@reviewComment</textarea>
                    </div>
                    <div style="text-align: center;">
                        <button type="submit" class="cta-button">@(hasReview ? "Обновить отзыв" : "Отправить отзыв")</button>
                    </div>
                </form>
            </div>
        }
        
        @if (ViewBag.Reviews != null)
        {
            var reviews = (IPagedList<SmartphoneShop.Core.Entities.Review>)ViewBag.Reviews;
            var avgRating = (double)ViewBag.AvgRating;

            var reviewCount = reviews.Count();
            @if (reviewCount > 0)
            {
                <div class="rating-summary" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; justify-content: center;">
                    <div style="font-size: 48px; font-weight: 700; color: #D44177;">@avgRating.ToString("0.0")</div>
                    <div>
                        <div style="color: #D44177; font-size: 18px; display: inline-flex; gap: 2px;">
                            @{
                                var fullStars = (int)Math.Floor(avgRating);
                                var hasHalf = avgRating - fullStars >= 0.25;
                            }
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= fullStars)
                                {
                                    <span>★</span>
                                }
                                else if (i == fullStars + 1 && hasHalf)
                                {
                                    <span style="opacity: 0.5;">★</span>
                                }
                                else
                                {
                                    <span style="color: #3a3a3a;">★</span>
                                }
                            }
                        </div>
                        <div style="color: #b0b0b0; font-size: 14px;">@reviewCount оценок</div>
                    </div>
                </div>
            }

            <div class="reviews-list" style="max-width: 700px; margin: 0 auto;">
                @foreach (var review in reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div class="service-card" style="margin-bottom: 16px; padding: 20px;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                            <div>
                                <strong style="color: #f0f0f0;">@(review.User?.FullName ?? review.User?.UserName)</strong>
                                <div style="color: #D44177; font-size: 14px;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span>@(i <= review.Rating ? "★" : "☆")</span>
                                    }
                                </div>
                            </div>
                            <span style="color: #b0b0b0; font-size: 12px;">@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div style="color: #b0b0b0; line-height: 1.6; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-word;">@Html.Raw(System.Text.RegularExpressions.Regex.Replace(System.Text.RegularExpressions.Regex.Replace(System.Text.RegularExpressions.Regex.Replace(System.Net.WebUtility.HtmlEncode(review.Comment ?? ""), @"\*\*(.+?)\*\*", "<b>$1</b>"), @"\*(.+?)\*", "<i>$1</i>"), @"~~(.+?)~~", "<s>$1</s>"))</div>
                        @if (User.Identity?.IsAuthenticated == true && review.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #3a3a3a;">
                                <span style="color:#888;font-size:12px;">Ваш отзыв</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (reviews.PageCount > 1)
            {
                <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; padding: 16px 0;">
                    @if (reviews.HasPreviousPage)
                    {
                        <a href="@Url.Action("Details", new { id = Model.Id, reviewPage = reviews.PageNumber - 1, reviewPageSize = reviews.PageSize })" class="page-link" style="padding: 6px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 13px;">← Назад</a>
                    }

                    @for (int i = 1; i <= reviews.PageCount; i++)
                    {
                        if (i == reviews.PageNumber)
                        {
                            <span style="padding: 6px 10px; background: #D44177; color: #fff; border-radius: 6px; font-size: 13px; font-weight: 600;">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Details", new { id = Model.Id, reviewPage = i, reviewPageSize = reviews.PageSize })" class="page-link" style="padding: 6px 10px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 13px;">@i</a>
                        }
                    }

                    @if (reviews.HasNextPage)
                    {
                        <a href="@Url.Action("Details", new { id = Model.Id, reviewPage = reviews.PageNumber + 1, reviewPageSize = reviews.PageSize })" class="page-link" style="padding: 6px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 13px;">Вперёд →</a>
                    }

                    <span style="color: #888; font-size: 12px; margin-left: 8px;">@reviews.FirstItemOnPage–@reviews.LastItemOnPage из @reviews.TotalItemCount отзывов</span>
                </div>
            }
        }
    </div>
</section>

<div id="lightbox" class="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close" onclick="event.stopPropagation(); closeLightbox()">&times;</span>
    <button class="nav-arrow prev" onclick="event.stopPropagation(); navigateImage(-1)" type="button">&#10094;</button>
    <img id="lightboxImg" class="lightbox-content" />
    <button class="nav-arrow next" onclick="event.stopPropagation(); navigateImage(1)" type="button">&#10095;</button>
    <div class="lightbox-counter" id="lightboxCounter"></div>
</div>

<script>
    var _images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allUrls));
    var _currentIdx = 0;

    function setImage(idx) {
        _currentIdx = idx;
        var img = document.getElementById('mainImage');
        if (img) img.src = _images[idx];
        document.querySelectorAll('.thumb-gallery img').forEach(function(t, i) {
            t.classList.toggle('active', i === idx);
        });
    }

    function navigateImage(dir) {
        var next = (_currentIdx + dir + _images.length) % _images.length;
        setImage(next);
        var lb = document.getElementById('lightboxImg');
        if (lb && lb.src) lb.src = _images[next];
        var counter = document.getElementById('lightboxCounter');
        if (counter) counter.textContent = (next + 1) + ' / ' + _images.length;
    }

    function openLightbox() {
        if (_images.length === 0) return;
        var lb = document.getElementById('lightbox');
        var img = document.getElementById('lightboxImg');
        img.src = _images[_currentIdx];
        var counter = document.getElementById('lightboxCounter');
        counter.textContent = (_currentIdx + 1) + ' / ' + _images.length;
        lb.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function(e) {
        var lb = document.getElementById('lightbox');
        if (lb && lb.style.display === 'flex') {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') navigateImage(-1);
            if (e.key === 'ArrowRight') navigateImage(1);
        }
    });

    function setRating(value) {
        document.getElementById('ratingValue').value = value;
        var stars = document.querySelectorAll('.rating-select .star');
        stars.forEach(function(star, index) {
            star.style.color = (index < value) ? '#D44177' : '#3a3a3a';
        });
    }

    function formatReviewText(command) {
        var ta = document.getElementById('reviewComment');
        if (!ta) return;
        var start = ta.selectionStart;
        var end = ta.selectionEnd;
        var selected = ta.value.substring(start, end);
        var wrapped = selected;
        switch(command) {
            case 'bold': wrapped = '**' + selected + '**'; break;
            case 'italic': wrapped = '*' + selected + '*'; break;
            case 'strike': wrapped = '~~' + selected + '~~'; break;
        }
        ta.setRangeText(wrapped, start, end, 'end');
        ta.focus();
    }

    @{
        var initRating = (int?)(ViewBag.UserReviewRating ?? 5);
    }
    (function() {
        setRating(@initRating);
    })();
</script>
