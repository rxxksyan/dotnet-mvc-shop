@model X.PagedList.IPagedList<SmartphoneShop.Core.Entities.PurchaseOrder>

@{
    ViewData["Title"] = "Мои запросы на покупку";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Список запросов на покупку</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Смартфон</th>
                                        <th>Дата запроса</th>
                                        <th>Статус</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.SmartphoneName</td>
                                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge bg-@item.Status switch-status" data-status="@item.Status">
                                                    @item.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
                                                @if (item.Status == "Pending")
                                                {
                                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Вы уверены, что хотите отменить этот запрос?')">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">У вас пока нет запросов на покупку.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.PageCount > 1)
    {
        <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; padding: 16px 0;">
            @if (Model.HasPreviousPage)
            {
                <a href="@Url.Action("Index", new { page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">← Назад</a>
            }

            @for (int i = 1; i <= Model.PageCount; i++)
            {
                if (i == Model.PageNumber)
                {
                    <span style="padding: 8px 12px; background: #D44177; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 600;">@i</span>
                }
                else
                {
                    <a href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 12px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">@i</a>
                }
            }

            @if (Model.HasNextPage)
            {
                <a href="@Url.Action("Index", new { page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="page-link" style="padding: 8px 16px; background: #2c2c2c; color: #f0f0f0; border-radius: 6px; text-decoration: none; font-size: 14px;">Вперёд →</a>
            }

            <span style="color: #888; font-size: 13px; margin-left: 10px;">Страница @Model.PageNumber из @Model.PageCount | Всего: @Model.TotalItemCount</span>
        </div>
    }
</div>

@section Scripts {
    <script>
        function GetStatusClass(status) {
            switch (status) {
                case "Pending": return "warning";
                case "Approved": return "success";
                case "Rejected": return "danger";
                case "Processing": return "info";
                case "Completed": return "success";
                default: return "secondary";
            }
        }

        function GetStatusText(status) {
            switch (status) {
                case "Pending": return "В ожидании";
                case "Approved": return "Одобрен";
                case "Rejected": return "Отклонен";
                case "Processing": return "В обработке";
                case "Completed": return "Завершен";
                default: return status;
            }
        }
    </script>
}