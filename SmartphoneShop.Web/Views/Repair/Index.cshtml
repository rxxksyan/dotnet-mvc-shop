@{
    ViewData["Title"] = "Ремонт смартфонов";
}

<section>
    <div class="container">
        <div class="service-card" style="text-align: center; padding: 60px 40px;">
            <h1 class="mb-4" style="font-size: 2.5rem;">Ремонт смартфонов</h1>
            <p class="mb-4" style="color: #b0b0b0; font-size: 1.1rem; max-width: 600px; margin: 0 auto 30px;">
                Профессиональный ремонт смартфонов любой сложности. Быстро, качественно, с гарантией.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 40px 0;">
            <div class="card" style="text-align: center; padding: 40px 30px; border-radius: 16px; background: #2c2c2c; border: 1px solid #3a3a3a;">
                <div style="width: 60px; height: 60px; margin: 0 auto 20px; border-radius: 12px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>
                </div>
                <h3 style="margin-bottom: 12px;">Быстрый ремонт</h3>
                <p style="color: #b0b0b0; margin: 0;">Большинство ремонтов выполняем за 1-2 часа</p>
            </div>
            <div class="card" style="text-align: center; padding: 40px 30px; border-radius: 16px; background: #2c2c2c; border: 1px solid #3a3a3a;">
                <div style="width: 60px; height: 60px; margin: 0 auto 20px; border-radius: 12px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3 style="margin-bottom: 12px;">Гарантия</h3>
                <p style="color: #b0b0b0; margin: 0;">Даём гарантию на все выполненные работы</p>
            </div>
            <div class="card" style="text-align: center; padding: 40px 30px; border-radius: 16px; background: #2c2c2c; border: 1px solid #3a3a3a;">
                <div style="width: 60px; height: 60px; margin: 0 auto 20px; border-radius: 12px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <h3 style="margin-bottom: 12px;">Честные цены</h3>
                <p style="color: #b0b0b0; margin: 0;">Прозрачное ценообразование без скрытых платежей</p>
            </div>
            <div class="card" style="text-align: center; padding: 40px 30px; border-radius: 16px; background: #2c2c2c; border: 1px solid #3a3a3a;">
                <div style="width: 60px; height: 60px; margin: 0 auto 20px; border-radius: 12px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                </div>
                <h3 style="margin-bottom: 12px;">Оригинальные запчасти</h3>
                <p style="color: #b0b0b0; margin: 0;">Используем только качественные комплектующие</p>
            </div>
        </div>

        <div class="service-card" style="padding: 40px; margin-bottom: 40px;">
            <h2 class="mb-4" style="text-align: center; margin-bottom: 30px;">Виды неисправностей</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 10px;">
                <div class="card" style="padding: 24px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                                <line x1="12" y1="18" x2="12.01" y2="18"/>
                            </svg>
                        </div>
                        <h4 style="margin: 0; color: #D44177;">Замена экрана</h4>
                    </div>
                    <p style="color: #b0b0b0; margin: 0;">Разбитый или не работающий дисплей</p>
                </div>
                <div class="card" style="padding: 24px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="6" width="22" height="12" rx="2" ry="2"/>
                                <line x1="6" y1="6" x2="6" y2="4"/>
                                <line x1="18" y1="6" x2="18" y2="4"/>
                                <line x1="6" y1="22" x2="6" y2="20"/>
                                <line x1="18" y1="22" x2="18" y2="20"/>
                            </svg>
                        </div>
                        <h4 style="margin: 0; color: #D44177;">Замена батареи</h4>
                    </div>
                    <p style="color: #b0b0b0; margin: 0;">Быстрая разрядка или вздутие аккумулятора</p>
                </div>
                <div class="card" style="padding: 24px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                            </svg>
                        </div>
                        <h4 style="margin: 0; color: #D44177;">Попала вода</h4>
                    </div>
                    <p style="color: #b0b0b0; margin: 0;">Восстановление после попадания жидкости</p>
                </div>
                <div class="card" style="padding: 24px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                            </svg>
                        </div>
                        <h4 style="margin: 0; color: #D44177;">Замена разъёма</h4>
                    </div>
                    <p style="color: #b0b0b0; margin: 0;">Не заряжается или не работает зарядка</p>
                </div>
                <div class="card" style="padding: 24px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                            </svg>
                        </div>
                        <h4 style="margin: 0; color: #D44177;">Замена динамика</h4>
                    </div>
                    <p style="color: #b0b0b0; margin: 0;">Нет звука или хрипит динамик</p>
                </div>
                <div class="card" style="padding: 24px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 12px;">
                    <div style="display: flex; align-items: center; margin-bottom: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212,65,119,0.15); display: flex; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D44177" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                            </svg>
                        </div>
                        <h4 style="margin: 0; color: #D44177;">Другие неисправности</h4>
                    </div>
                    <p style="color: #b0b0b0; margin: 0;">Любые другие проблемы с вашим смартфоном</p>
                </div>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="service-card" style="padding: 40px; max-width: 700px; margin: 0 auto 40px;">
                <h2 class="mb-4" style="text-align: center;">Оставить заявку на ремонт</h2>
                

                <form method="post" action="/repair/create">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label class="form-label">Модель смартфона</label>
                        <input type="text" name="smartphoneModel" class="form-control" required placeholder="Samsung Galaxy S24, iPhone 15 и т.д." />
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label class="form-label">Описание проблемы</label>
                        <textarea name="issueDescription" class="form-control" required placeholder="Опишите проблему подробно..." rows="5"></textarea>
                    </div>
                    
                    <button type="submit" class="cta-button" style="width: 100%;">Отправить заявку</button>
                </form>
            </div>

            <div class="service-card" style="padding: 40px;">
                <h2 class="mb-4" style="text-align: center;">Мои заявки</h2>
                
                @if (ViewBag.Repairs != null)
                {
                    var repairs = ViewBag.Repairs as IEnumerable<SmartphoneShop.Core.Entities.RepairRequest>;
                    if (repairs != null && repairs.Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 20px;">
                            @foreach (var request in repairs)
                            {
                                if (request == null) continue;
                                <div style="padding: 24px; background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 12px;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                                        <div>
                                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                                <h4 style="margin: 0; font-size: 18px;">@request.SmartphoneModel</h4>
                                                @{
                                                     string statusText = request.Status switch
                                                     {
                                                         SmartphoneShop.Core.Enums.RepairStatus.New => "Новая",
                                                         SmartphoneShop.Core.Enums.RepairStatus.DeliveryToCenter => "Доставка в центр",
                                                         SmartphoneShop.Core.Enums.RepairStatus.AcceptedAtCenter => "Принят в центр",
                                                         SmartphoneShop.Core.Enums.RepairStatus.InQueue => "В очереди",
                                                         SmartphoneShop.Core.Enums.RepairStatus.Diagnostics => "Диагностика",
                                                         SmartphoneShop.Core.Enums.RepairStatus.RepairApproval => "Ожидает одобрения",
                                                         SmartphoneShop.Core.Enums.RepairStatus.InRepair => "В ремонте",
                                                         SmartphoneShop.Core.Enums.RepairStatus.ReadyForPickup => "Готов к выдаче",
                                                         SmartphoneShop.Core.Enums.RepairStatus.Completed => "Завершён",
                                                         SmartphoneShop.Core.Enums.RepairStatus.Cancelled => "Отменён",
                                                         _ => "Новая"
                                                     };
                                                     string statusClass = request.Status switch
                                                     {
                                                         SmartphoneShop.Core.Enums.RepairStatus.Completed => "status-done",
                                                         SmartphoneShop.Core.Enums.RepairStatus.Cancelled => "status-stopped",
                                                         SmartphoneShop.Core.Enums.RepairStatus.InRepair => "status-active",
                                                         SmartphoneShop.Core.Enums.RepairStatus.ReadyForPickup => "status-active",
                                                         SmartphoneShop.Core.Enums.RepairStatus.RepairApproval => "status-neutral",
                                                         SmartphoneShop.Core.Enums.RepairStatus.Diagnostics => "status-neutral",
                                                         SmartphoneShop.Core.Enums.RepairStatus.InQueue => "status-neutral",
                                                         SmartphoneShop.Core.Enums.RepairStatus.AcceptedAtCenter => "status-neutral",
                                                         SmartphoneShop.Core.Enums.RepairStatus.DeliveryToCenter => "status-neutral",
                                                         _ => "status-neutral"
                                                     };
                                                }
                                                <span class="badge @statusClass" style="padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 500;">@statusText</span>
                                            </div>
                                            <p style="margin: 0 0 8px 0; color: #b0b0b0; font-size: 14px;">Создана: @request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                            <p style="margin: 0; color: #b0b0b0; font-size: 14px;">@request.IssueDescription</p>
                                            @if (request.EstimatedPrice.HasValue)
                                            {
                                                <p style="margin: 12px 0 0 0; font-size: 16px; font-weight: 600; color: #D44177;">Оценка: @request.EstimatedPrice.Value.ToString("N0") BYN</p>
                                            }
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(request.AdminNotes))
                                    {
                                        <div style="margin-top: 12px; padding: 12px 16px; background: rgba(212, 65, 119, 0.08); border-left: 3px solid #D44177; border-radius: 6px;">
                                            <p style="margin: 0; font-size: 13px; color: #f0f0f0;"><strong>Мастер:</strong> @request.AdminNotes</p>
                                        </div>
                                    }
                                    
                                    @if (request.Status == SmartphoneShop.Core.Enums.RepairStatus.RepairApproval)
                                    {
                                        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #2c2c2c;">
                                            <p style="color: #D44177; margin: 0 0 10px 0; font-size: 14px;"><strong>Мастер ожидает вашего одобрения</strong></p>
                                            <div style="display: flex; gap: 10px;">
                                                <form method="post" action="/repair/respond" style="display: inline;">
                                                    <input type="hidden" name="id" value="@request.Id" />
                                                    <input type="hidden" name="approve" value="true" />
                                                    <button type="submit" class="cta-button" style="padding: 8px 20px; font-size: 13px;">Одобрить ремонт</button>
                                                </form>
                                                <form method="post" action="/repair/respond" style="display: inline;">
                                                    <input type="hidden" name="id" value="@request.Id" />
                                                    <input type="hidden" name="approve" value="false" />
                                                    <button type="submit" class="cta-button" style="padding: 8px 20px; font-size: 13px; background: #3a3a3a; color: #888;">Отклонить</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (request.Status == SmartphoneShop.Core.Enums.RepairStatus.Diagnostics || request.Status == SmartphoneShop.Core.Enums.RepairStatus.InRepair)
                                    {
                                        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #2c2c2c;">
                                            <form method="post" action="/repair/respond">
                                                <input type="hidden" name="id" value="@request.Id" />
                                                <div class="form-group" style="margin-bottom: 10px;">
                                                    <label class="form-label" style="font-size: 13px;">Ответить мастеру</label>
                                                    <textarea name="message" class="form-control" rows="2" placeholder="Ваше сообщение..." style="padding: 10px; background: #2c2c2c; border: 1px solid #3a3a3a; border-radius: 8px; color: #f0f0f0; font-size: 13px;"></textarea>
                                                </div>
                                                <button type="submit" class="cta-button" style="padding: 8px 20px; font-size: 13px;">Отправить</button>
                                            </form>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(request.ClientMessage))
                                    {
                                        <div style="margin-top: 10px; padding: 12px; background: rgba(212, 65, 119, 0.08); border-left: 3px solid #D44177; border-radius: 4px;">
                                            <p style="margin: 0; color: #f0f0f0; font-size: 14px;"><strong>Ваше сообщение:</strong> @request.ClientMessage</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 20px;">
                            <p style="color: #b0b0b0; margin: 0;">У вас пока нет заявок на ремонт</p>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <p style="color: #b0b0b0; margin: 0;">У вас пока нет заявок на ремонт</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="service-card" style="padding: 60px 40px; text-align: center; margin-bottom: 40px;">
                <h3 class="mb-3">Хотите оставить заявку?</h3>
                <p class="mb-4" style="color: #b0b0b0;">Для подачи заявки на ремонт необходимо войти в аккаунт</p>
                <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                    <a href="/account/login" class="cta-button">Войти</a>
                    <a href="/account/register" class="cta-button" style="background: #3a3a3a;">Регистрация</a>
                </div>
            </div>
        }
    </div>
</section>