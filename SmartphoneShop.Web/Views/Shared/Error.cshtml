@model ErrorViewModel
@{
    var statusCode = Context.Request.Query["statusCode"];
    var is404 = statusCode == "404";
    ViewData["Title"] = is404 ? "Страница не найдена" : "Ошибка";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section>
    <div class="container" style="text-align: center; padding: 80px 0;">
        @if (is404)
        {
            <h1 style="font-size: 72px; color: #D44177; margin-bottom: 20px;">404</h1>
            <h2 style="margin-bottom: 16px;">Страница не найдена</h2>
            <p style="color: #b0b0b0; margin-bottom: 32px; max-width: 500px; margin-left: auto; margin-right: auto;">
                Запрашиваемая страница не существует или была удалена.
            </p>
            <a href="/" class="cta-button">На главную</a>
        }
        else
        {
            <h1 style="font-size: 72px; color: #D44177; margin-bottom: 20px;">500</h1>
            <h2 style="margin-bottom: 16px;">Внутренняя ошибка сервера</h2>
            <p style="color: #b0b0b0; margin-bottom: 32px; max-width: 500px; margin-left: auto; margin-right: auto;">
                Произошла непредвиденная ошибка. Попробуйте повторить запрос позже.
            </p>
            @if (Model.ShowRequestId)
            {
                <p style="color: #666; font-size: 13px; margin-bottom: 32px;">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }
            <a href="/" class="cta-button">На главную</a>
        }
    </div>
</section>
